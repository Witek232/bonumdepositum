---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const cycles = await getCollection('cycles');
const filtered = cycles
  .filter((c) => c.data.lang === 'pl')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const t = {
  title: 'Cykle tematyczne',
  subtitle: 'Systematyczne ścieżki poznania',
  description:
    'Od katechizmu po historię filozofii — wybierz cykl i podążaj uporządkowaną drogą przez dziedziny mądrości.',
  empty: 'Brak dostępnych cykli w tym języku.',
  cta: 'Przeglądaj lekcje',
};
---

<Layout
  title={t.title}
  description={t.description}
  lang="pl"
  image="/og-image.jpg"
>
  {/* Nagłówek strony — pełna szerokość, ciemny */}
  <section class="relative overflow-hidden bg-ink-950 pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none"
      style="background-image: radial-gradient(circle at 1px 1px, #d4a843 0.5px, transparent 0); background-size: 60px 60px;"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
        {t.subtitle}
      </p>
      <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-parchment-50 lg:text-5xl">
        {t.title}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/60">
        {t.description}
      </p>
      <div class="mx-auto mt-8 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
    </div>
  </section>

  {/* Każdy cykl = pełnoszerokościowy hero-blok */}
  {
    filtered.length === 0 ? (
      <section class="bg-ink-950 py-20">
        <p class="text-center text-parchment-200/50">{t.empty}</p>
      </section>
    ) : (
      filtered.map((cycle, idx) => (
        <section class="cycle-hero relative overflow-hidden bg-ink-950">
          {/* Tło: okładka lub ornament */}
          {cycle.data.coverImage ? (
            <div class="absolute inset-0 z-0">
              <img
                src={cycle.data.coverImage}
                alt=""
                class="h-full w-full object-cover opacity-20"
                loading={idx === 0 ? 'eager' : 'lazy'}
              />
              <div class="absolute inset-0 bg-gradient-to-b from-ink-950/80 via-ink-950/88 to-ink-950/95" />
              <div class="absolute inset-0 bg-gradient-to-r from-ink-950/50 via-transparent to-ink-950/50" />
            </div>
          ) : (
            <div
              class="absolute inset-0 opacity-[0.02] pointer-events-none"
              style="background-image: radial-gradient(circle at 1px 1px, #d4a843 0.5px, transparent 0); background-size: 60px 60px;"
              aria-hidden="true"
            />
          )}

          {/* Ornament górny */}
          <div
            class="absolute left-1/2 -translate-x-1/2 z-10 opacity-20 pointer-events-none"
            style="top: 2rem;"
            aria-hidden="true"
          >
            <svg width="200" height="40" viewBox="0 0 200 40" fill="none">
              <path d="M0 20 H80 M120 20 H200" stroke="#d4a843" stroke-width="1" />
              <circle cx="100" cy="20" r="8" stroke="#d4a843" stroke-width="1" fill="none" />
              <circle cx="100" cy="20" r="3" fill="#d4a843" />
              <path d="M85 20 L92 13 M85 20 L92 27 M115 20 L108 13 M115 20 L108 27" stroke="#d4a843" stroke-width="1" />
            </svg>
          </div>

          {/* Treść — dopasowana do długości opisu */}
          <div class="relative z-10 mx-auto max-w-4xl px-6 py-16 lg:py-24 text-center">
            <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
              Cykl tematyczny
            </p>
            <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-parchment-50">
              {cycle.data.title}
            </h2>
            <div class="mx-auto mt-6 h-px w-20 bg-gradient-to-r from-transparent via-gold-500 to-transparent" />
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/70">
              {cycle.data.description}
            </p>
            <div class="mt-10">
              <a
                href={`/cycles/${cycle.id}/`}
                class="inline-flex items-center gap-2 rounded-lg border border-gold-500/30 bg-gold-500/10 px-8 py-4 text-sm font-semibold uppercase tracking-wider text-gold-400 backdrop-blur-sm transition-all duration-300 hover:border-gold-400 hover:bg-gold-500/20 hover:text-gold-300"
              >
                {t.cta}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          {/* Dolna linia dekoracyjna + separator do następnej sekcji */}
          <div class="absolute right-0 bottom-0 left-0 z-10 h-px bg-gradient-to-r from-transparent via-gold-500/30 to-transparent" aria-hidden="true" />
        </section>
      ))
    )
  }
</Layout>

<style>
  img {
    margin: 0;
    border-radius: 0;
  }
</style>
