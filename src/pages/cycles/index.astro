---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const cycles = await getCollection('cycles');
const filtered = cycles
  .filter((c) => c.data.lang === 'pl')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const t = {
  title: 'Cykle tematyczne',
  subtitle: 'Systematyczne ścieżki poznania',
  description:
    'Od katechizmu po historię filozofii — wybierz cykl i podążaj uporządkowaną drogą przez dziedziny mądrości.',
  empty: 'Brak dostępnych cykli w tym języku.',
  cta: 'Rozpocznij cykl',
  lessons: 'lekcji',
};
---

<Layout
  title={t.title}
  description={t.description}
  lang="pl"
  image="/og-image.jpg"
>
  <main class="main-content min-h-screen pt-24 pb-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Nagłówek -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-2 border-b-2 border-gold-500 pb-2">
          {t.title}
        </h2>
        <p class="mt-3 text-ink-700/80 leading-relaxed">
          {t.description}
        </p>
      </section>

      <!-- Lista cykli — układ pionowy, jeden pod drugim -->
      {
        filtered.length === 0 ? (
          <p class="text-center text-ink-700/60">{t.empty}</p>
        ) : (
          <div class="flex flex-col gap-6">
            {filtered.map((cycle) => (
              <a
                href={`/cycles/${cycle.id}/`}
                class="group flex flex-col sm:flex-row items-start gap-6 rounded-xl border border-parchment-200 bg-parchment-100 shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
              >
                {/* Miniaturka */}
                <div class="sm:w-48 md:w-56 flex-shrink-0 bg-ink-950 aspect-video sm:aspect-[4/3] overflow-hidden relative">
                  {cycle.data.coverImage ? (
                    <img
                      src={cycle.data.coverImage}
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="h-full w-full flex items-center justify-center">
                      <svg
                        class="h-10 w-10 text-parchment-200/30"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                      </svg>
                    </div>
                  )}
                </div>

                {/* Treść */}
                <div class="flex-1 p-5 sm:pl-0 sm:pr-5 sm:py-5">
                  <h3 class="text-xl font-bold text-ink-900 group-hover:text-gold-600 transition-colors mb-2">
                    {cycle.data.title}
                  </h3>
                  <p class="text-sm text-ink-700/80 leading-relaxed line-clamp-3">
                    {cycle.data.description}
                  </p>
                  <div class="mt-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gold-600 group-hover:text-gold-500 transition-colors">
                    {t.cta}
                    <svg
                      class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </main>
</Layout>

<style>
  img {
    margin: 0;
    border-radius: 0;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
