---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cycles = await getCollection('cycles');
  return cycles.map((entry) => ({
    params: { slug: entry.id },
    props: { cycle: entry },
  }));
}

const { cycle } = Astro.props;
const allLessons = await getCollection('blog');

const lessons = allLessons
  .filter((l) => {
    const c = l.data.cycle;
    if (!c) return false;
    return typeof c === 'string' ? c === cycle.id : c.id === cycle.id;
  })
  .sort((a, b) => {
    const na = (a.data as any).lessonNumber;
    const nb = (b.data as any).lessonNumber;
    if (typeof na === 'number' && typeof nb === 'number') return na - nb;
    return a.data.pubDate.getTime() - b.data.pubDate.getTime();
  });

const t = {
  back: '← Wszystkie cykle',
  lessonsTitle: 'Lekcje w cyklu',
  empty: 'Wkrótce pojawią się pierwsze lekcje.',
  meta: {
    video: 'Wideo',
    audio: 'Audio',
    author: 'Autor',
    date: 'Data',
    read: 'Czytaj',
  },
};
---

<Layout
  title={cycle.data.title}
  description={cycle.data.description}
  lang={cycle.data.lang ?? 'pl'}
  image={cycle.data.coverImage ?? '/og-image.jpg'}
  heroPage={true}
>
  <PageHero bgImage={cycle.data.coverImage ?? undefined} minHeight="min-h-[60vh]">
    <a
      href="/cycles/"
      class="inline-flex items-center gap-1.5 text-sm text-parchment-200/50 hover:text-gold-400 transition-colors mb-8"
    >
      {t.back}
    </a>

    <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
      Cykl tematyczny · {lessons.length} lekcji
    </p>
    <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight tracking-tight text-parchment-50">
      {cycle.data.title}
    </h1>
    <div class="mx-auto mt-6 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent" />
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/70">
      {cycle.data.description}
    </p>
  </PageHero>

  <div class="main-content min-h-screen shadow-2xl rounded-t-2xl -mt-4 pt-16 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
    <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-8 border-b-2 border-gold-500 pb-2">
        {t.lessonsTitle}
      </h2>

      {lessons.length === 0 ? (
        <p class="text-ink-700/60">{t.empty}</p>
      ) : (
        <div class="flex flex-col gap-4">
          {lessons.map((lesson, idx) => {
            const hasVideo = Boolean((lesson.data as any).videoId);
            const hasAudio = Boolean(lesson.data.audioUrl);
            const lessonNumber = (lesson.data as any).lessonNumber ?? idx + 1;

            return (
              <a
                href={`/blog/${lesson.id}/`}
                class="group flex items-start gap-5 rounded-xl border border-parchment-200 bg-parchment-100 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 p-5"
              >
                <div class="hidden sm:flex flex-shrink-0 w-12 h-12 rounded-lg bg-ink-950 items-center justify-center shadow-inner">
                  <span class="font-display text-xl font-bold text-gold-400">
                    {String(lessonNumber).padStart(2, '0')}
                  </span>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    <h3 class="text-lg font-bold text-ink-900 group-hover:text-gold-600 transition-colors leading-snug">
                      {lesson.data.title}
                    </h3>
                    {hasVideo && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-red-700 border border-red-200/60">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                        {t.meta.video}
                      </span>
                    )}
                    {hasAudio && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-gold-50 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-gold-700 border border-gold-200/60">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                        {t.meta.audio}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-ink-700/70 leading-relaxed line-clamp-2 mb-2.5">
                    {lesson.data.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-700/50">
                    {lesson.data.author && (
                      <span class="flex items-center gap-1">
                        <svg class="h-3.5 w-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        {lesson.data.author}
                      </span>
                    )}
                    <span class="flex items-center gap-1">
                      <svg class="h-3.5 w-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                      {lesson.data.pubDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                    <span class="ml-auto flex items-center gap-1 font-medium text-gold-600 group-hover:text-gold-500 transition-colors">
                      {t.meta.read}
                      <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  img,
  .hero-bg {
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
