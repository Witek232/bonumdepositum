---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('reading');
const filtered = all
  .filter((r) => r.data.lang === 'pl')
  .sort((a, b) => {
    const da = a.data.pubDate?.getTime() ?? 0;
    const db = b.data.pubDate?.getTime() ?? 0;
    return db - da;
  });

const t = {
  title: 'Czytelnia',
  subtitle: 'Archiwalia, dokumenty i źródła',
  description:
    'Publikacje, listy i teksty źródłowe — od listów pasterskich po dokumenty architektoniczne i duchowe.',
  empty: 'Brak dostępnych pozycji w tym języku.',
  read: 'Czytaj',
  source: 'Źródło',
};
---

<Layout
  title={t.title}
  description={t.description}
  lang="pl"
  image="/og-image.jpg"
  heroPage={true}
>
  {/* ====== HERO ====== */}
  <section class="relative overflow-hidden bg-ink-950 min-h-[50vh] pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none"
      style="background-image: radial-gradient(circle at 1px 1px, #d4a843 0.5px, transparent 0); background-size: 60px 60px;"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute left-1/2 -translate-x-1/2 z-10 opacity-20 pointer-events-none"
      style="top: 2rem;"
      aria-hidden="true"
    >
      <svg width="200" height="40" viewBox="0 0 200 40" fill="none">
        <path d="M0 20 H80 M120 20 H200" stroke="#d4a843" stroke-width="1" />
        <circle cx="100" cy="20" r="8" stroke="#d4a843" stroke-width="1" fill="none" />
        <circle cx="100" cy="20" r="3" fill="#d4a843" />
        <path d="M85 20 L92 13 M85 20 L92 27 M115 20 L108 13 M115 20 L108 27" stroke="#d4a843" stroke-width="1" />
      </svg>
    </div>

    <div class="relative z-10 mx-auto max-w-[50rem] px-6 text-center">
      <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
        {t.subtitle}
      </p>
      <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-parchment-50 lg:text-5xl">
        {t.title}
      </h1>
      <div class="mx-auto mt-6 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent" />
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/70">
        {t.description}
      </p>
    </div>

    <div
      class="absolute right-0 bottom-0 left-0 z-10 h-px bg-gradient-to-r from-transparent via-gold-500/30 to-transparent"
      aria-hidden="true"
    />
  </section>

  {/* ====== LISTA ====== */}
  <div class="main-content min-h-screen shadow-2xl rounded-t-2xl -mt-4 pt-16 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
    <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
      {filtered.length === 0 ? (
        <p class="text-center text-ink-700/60">{t.empty}</p>
      ) : (
        <div class="flex flex-col gap-6">
          {filtered.map((item) => (
            <a
              href={`/reading/${item.id}/`}
              class="group flex flex-col sm:flex-row items-start gap-6 rounded-xl border border-parchment-200 bg-parchment-100 shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
            >
              {/* Miniaturka */}
              <div class="sm:w-48 md:w-56 flex-shrink-0 bg-parchment-200 aspect-video sm:aspect-[4/3] overflow-hidden relative">
                {item.data.coverImage ? (
                  <img
                    src={item.data.coverImage}
                    alt=""
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="h-full w-full flex items-center justify-center">
                    <svg
                      class="h-10 w-10 text-parchment-400"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                    </svg>
                  </div>
                )}
              </div>

              {/* Treść */}
              <div class="flex-1 p-5 sm:pl-0 sm:pr-5 sm:py-5">
                <h2 class="text-xl font-bold text-ink-900 group-hover:text-gold-600 transition-colors mb-2">
                  {item.data.title}
                </h2>
                {item.data.author && (
                  <p class="text-sm text-ink-700/60 mb-2">{item.data.author}</p>
                )}
                <p class="text-sm text-ink-700/80 leading-relaxed line-clamp-3">
                  {item.data.description}
                </p>
                <div class="mt-4 flex items-center gap-3">
                  <span class="flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-gold-600 group-hover:text-gold-500 transition-colors">
                    {t.read}
                    <svg
                      class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </span>
                  {item.data.source && (
                    <span class="text-xs text-ink-700/40">
                      · {t.source}
                    </span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  img {
    margin: 0;
    border-radius: 0;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
