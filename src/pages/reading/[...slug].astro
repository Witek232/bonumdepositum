---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('reading');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const t = {
  back: '← Czytelnia',
  source: 'Źródło',
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang ?? 'pl'}
  image={entry.data.coverImage ?? '/og-image.jpg'}
  heroPage={true}
>
  <PageHero bgImage={entry.data.coverImage ?? undefined} minHeight="min-h-[60vh]">
    <a
      href="/reading/"
      class="inline-flex items-center gap-1.5 text-sm text-parchment-200/50 hover:text-gold-400 transition-colors mb-8"
    >
      {t.back}
    </a>

    <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight tracking-tight text-parchment-50">
      {entry.data.title}
    </h1>

    <div class="mx-auto mt-6 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent" />

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-parchment-200/60">
      {entry.data.author && (
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {entry.data.author}
        </span>
      )}
      {entry.data.pubDate && (
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          {entry.data.pubDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
      )}
    </div>
  </PageHero>

  <div class="main-content min-h-screen shadow-2xl rounded-t-2xl -mt-4 pt-12 pb-24 lg:pt-16 lg:pb-32 overflow-hidden">
    <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
      {entry.data.source && (
        <div class="mb-8 p-4 rounded-xl border border-gold-500/20 bg-gold-500/5 flex items-start gap-3">
          <svg class="h-5 w-5 text-gold-600 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gold-700 mb-1">{t.source}</p>
            <a
              href={entry.data.source}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-ink-700/80 hover:text-gold-600 transition-colors break-all"
            >
              {entry.data.source}
            </a>
          </div>
        </div>
      )}

      <div class="prose-custom text-ink-800 leading-relaxed text-lg">
        <Content />
      </div>
    </div>
  </div>
</Layout>

<style>
  img {
    margin: 0;
    border-radius: 0;
  }
  .prose-custom :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-ink-900);
    font-weight: 700;
    line-height: 1.25;
  }
  .prose-custom :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink-800);
    font-weight: 700;
  }
  .prose-custom :global(p) {
    margin-bottom: 1.25em;
  }
  .prose-custom :global(strong) {
    color: var(--color-ink-900);
    font-weight: 700;
  }
  .prose-custom :global(blockquote) {
    border-left: 3px solid var(--color-gold-500);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-ink-700);
  }
  .prose-custom :global(ul, ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25em;
  }
  .prose-custom :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-custom :global(img) {
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    max-width: 100%;
    height: auto;
    display: block;
  }
  .prose-custom :global(a) {
    color: var(--color-gold-600);
    text-decoration: none;
    transition: color 0.2s;
  }
  .prose-custom :global(a:hover) {
    color: var(--color-gold-500);
    text-decoration: underline;
  }
  .prose-custom :global(hr) {
    border: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-parchment-300), transparent);
    margin: 2.5rem 0;
  }
</style>
