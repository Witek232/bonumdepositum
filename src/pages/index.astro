---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'pl');
const latestPosts = allPosts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
).slice(0, 3);
---

<Layout 
  title="Strona Główna" 
  description="Odkrywaj historię, architekturę i duchowość."
  lang="pl"
>
  
  <!-- 1. HERO na pełnej szerokości, dotyka samej góry pod nawigacją -->
  <Hero />

  <!-- 2. KARTA PERGAMINU - zaczyna się dopiero pod Hero -->
  <main class="main-content min-h-screen shadow-2xl rounded-t-2xl pt-12 pb-12 -mt-4">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <section class="my-12">
        <h2 class="text-2xl font-bold mb-6 border-b-2 border-gold-500 pb-2">Najnowsze artykuły</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <article class="bg-parchment-100 border border-parchment-200 rounded-lg shadow-md overflow-hidden hover:shadow-xl transition">
              <div class="p-6">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-ink-700/60">
                  {post.data.pubDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <h3 class="text-xl font-bold mt-2 mb-2">
                  <a href={`/blog/${post.id}`} class="hover:text-gold-600 transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-ink-700/80 mb-4">
                  {post.data.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

</Layout>
