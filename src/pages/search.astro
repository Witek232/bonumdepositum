---
import { getCollection } from 'astro:content';

const searchQuery = Astro.url.searchParams.get('search')?.trim().toLowerCase() || '';

// Jeśli nie ma frazy wyszukiwania — przekieruj na blog
if (!searchQuery) {
  return Astro.redirect('/blog');
}

const blogPosts = await getCollection('blog');
const cycles = await getCollection('cycles');

// Filtruj wyniki tylko jeśli jest fraza
const blogResults = blogPosts
  .filter(post => {
    const titleMatch = post.data.title.toLowerCase().includes(searchQuery);
    const descMatch = post.data.description?.toLowerCase().includes(searchQuery) || false;
    const tagMatch = post.data.tags?.some(tag => tag.toLowerCase().includes(searchQuery)) || false;
    return titleMatch || descMatch || tagMatch;
  })
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const cycleResults = cycles
  .filter(cycle => {
    const titleMatch = cycle.data.title.toLowerCase().includes(searchQuery);
    const descMatch = cycle.data.description?.toLowerCase().includes(searchQuery) || false;
    return titleMatch || descMatch;
  });
---

<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <title>Wyniki wyszukiwania: {searchQuery}</title>
</head>
<body class="bg-zinc-950 text-zinc-200">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Wyniki wyszukiwania</h1>
      <p class="text-zinc-400 mt-1">Szukana fraza: <strong class="text-amber-400">"{searchQuery}"</strong></p>
    </div>

    {blogResults.length === 0 && cycleResults.length === 0 && (
      <div class="text-center py-12">
        <p class="text-xl text-zinc-400">Nie znaleziono żadnych wyników dla frazy <strong>"{searchQuery}"</strong>.</p>
        <a href="/blog" class="inline-block mt-6 text-amber-400 hover:underline">Przejdź do bloga →</a>
      </div>
    )}

    <!-- Wyniki z bloga -->
    {blogResults.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
          Artykuły na blogu 
          <span class="text-sm font-normal text-zinc-400">({blogResults.length})</span>
        </h2>
        <div class="space-y-3">
          {blogResults.map(post => (
            <a 
              href={`/blog/${post.id}/`} 
              class="block p-5 border border-zinc-800 rounded-xl hover:border-amber-500/50 hover:bg-zinc-900/50 transition group"
            >
              <h3 class="font-semibold text-lg group-hover:text-amber-400 transition">{post.data.title}</h3>
              {post.data.description && (
                <p class="text-zinc-400 text-sm mt-1 line-clamp-2">{post.data.description}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex gap-2 mt-3">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="text-xs px-2 py-0.5 bg-zinc-800 rounded">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Wyniki z cykli -->
    {cycleResults.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
          Cykle 
          <span class="text-sm font-normal text-zinc-400">({cycleResults.length})</span>
        </h2>
        <div class="space-y-3">
          {cycleResults.map(cycle => (
            <a 
              href={`/cycles/${cycle.id}/`} 
              class="block p-5 border border-zinc-800 rounded-xl hover:border-amber-500/50 hover:bg-zinc-900/50 transition group"
            >
              <h3 class="font-semibold text-lg group-hover:text-amber-400 transition">{cycle.data.title}</h3>
              {cycle.data.description && (
                <p class="text-zinc-400 text-sm mt-1 line-clamp-2">{cycle.data.description}</p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</body>
</html>
