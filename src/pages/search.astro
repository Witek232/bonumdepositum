---
import { getCollection } from 'astro:content';

const searchQuery = Astro.url.searchParams.get('search')?.toLowerCase() || '';

const blogPosts = await getCollection('blog');
const cycles = await getCollection('cycles');

// Filtruj wyniki
const blogResults = blogPosts
  .filter(post => 
    post.data.title.toLowerCase().includes(searchQuery) ||
    (post.data.description && post.data.description.toLowerCase().includes(searchQuery)) ||
    (post.data.tags && post.data.tags.some(tag => tag.toLowerCase().includes(searchQuery)))
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const cycleResults = cycles
  .filter(cycle => 
    cycle.data.title.toLowerCase().includes(searchQuery) ||
    (cycle.data.description && cycle.data.description.toLowerCase().includes(searchQuery))
  );
---

<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <title>Wyniki wyszukiwania: {searchQuery}</title>
</head>
<body>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">Wyniki wyszukiwania</h1>
    <p class="text-gray-400 mb-8">Szukana fraza: <strong>{searchQuery}</strong></p>

    {blogResults.length === 0 && cycleResults.length === 0 && (
      <p class="text-gray-400">Nie znaleziono żadnych wyników.</p>
    )}

    <!-- Wyniki z bloga -->
    {blogResults.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4">Artykuły na blogu ({blogResults.length})</h2>
        <div class="space-y-4">
          {blogResults.map(post => (
            <a href={`/blog/${post.id}/`} class="block p-4 border border-gray-700 rounded-lg hover:bg-gray-900 transition">
              <h3 class="font-medium text-lg">{post.data.title}</h3>
              {post.data.description && <p class="text-gray-400 text-sm mt-1">{post.data.description}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Wyniki z cykli -->
    {cycleResults.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold mb-4">Cykle ({cycleResults.length})</h2>
        <div class="space-y-4">
          {cycleResults.map(cycle => (
            <a href={`/cycles/${cycle.id}/`} class="block p-4 border border-gray-700 rounded-lg hover:bg-gray-900 transition">
              <h3 class="font-medium text-lg">{cycle.data.title}</h3>
              {cycle.data.description && <p class="text-gray-400 text-sm mt-1">{cycle.data.description}</p>}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</body>
</html>
