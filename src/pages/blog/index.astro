---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// FIX SEO: Poprzednio filtrowałeś !cycle i usuwałeś 113 stron (katechizm + tyrania + serce)
// Teraz pokazujemy wszystko, ale w sekcjach - Google znajduje linki wewnętrzne

const standalone = allPosts
  .filter(p => !p.data.cycle)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Ostatnie lekcje z cykli - naprawia "Strona odsyłająca: Nie wykryto" dla Google
const inCycles = allPosts
  .filter(p => p.data.cycle)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 24); // 24 ostatnie lekcje = 2 rzędy, lepszy crawl budget

const cycles = await getCollection('cycles');
const sortedCycles = cycles
  .filter(c => c.data.lang === 'pl')
  .sort((a,b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Policz lekcje per cykl dla UI
const lessonsByCycle: Record<string, number> = {};
for (const post of allPosts) {
  if (!post.data.cycle) continue;
  const cycleId = typeof post.data.cycle === 'string' ? post.data.cycle : post.data.cycle.id;
  lessonsByCycle[cycleId] = (lessonsByCycle[cycleId] ?? 0) + 1;
}

const t = {
  title: 'Blog – filozofia, duchowość i kultura',
  subtitle: 'Artykuły i eseje',
  description: 'Eseje i artykuły o filozofii, duchowości, kulturze i społeczeństwie — oraz wszystkie lekcje z cykli tematycznych. Znajdziesz tu 50 lekcji katechizmu Fultona Sheena, podręcznik tyranii i inne cykle.',
  read: 'Czytaj',
  standaloneTitle: 'Artykuły',
  cyclesTitle: 'Ostatnie lekcje z cykli',
  allCyclesTitle: 'Cykle tematyczne',
  empty: 'Brak dostępnych artykułów.',
  allLessons: 'Wszystkie lekcje',
  count: 'lekcji',
};
---

<Layout
  title={t.title}
  description={t.description}
  lang="pl"
  image="/og-image.jpg"
  heroPage={true}
>
  <PageHero minHeight="min-h-[50vh]">
    <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
      {t.subtitle}
    </p>
    <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-parchment-50 lg:text-5xl">
      {t.title}
    </h1>
    <div class="mx-auto mt-6 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent" />
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/70">
      {t.description}
    </p>
  </PageHero>

  <div class="main-content min-h-screen shadow-2xl rounded-t-2xl -mt-4 pt-16 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
    <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
      
      {/* SEKCJA 1: CYKLE - KLUCZOWE DLA SEO - LINKUJE DO WSZYSTKICH 113 LEKCJI */}
      <section class="mb-14">
        <h2 class="text-2xl font-bold mb-2 border-b-2 border-gold-500 pb-2 flex items-baseline justify-between">
          <span>{t.allCyclesTitle}</span>
          <span class="text-sm font-normal text-ink-700/50">{sortedCycles.length} cykle • {allPosts.filter(p => p.data.cycle).length} {t.count}</span>
        </h2>
        <p class="text-sm text-ink-700/60 mb-6">Wybierz cykl, aby zobaczyć pełną listę lekcji. To naprawia problem orphan pages w Google Search Console.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sortedCycles.map(cycle => {
            const count = lessonsByCycle[cycle.id] ?? 0;
            return (
              <a href={`/cycles/${cycle.id}/`} class="group rounded-xl border border-parchment-200 bg-parchment-100 p-5 hover:shadow-md hover:border-gold-500/30 transition-all duration-300 hover:-translate-y-0.5">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h3 class="font-bold text-ink-900 group-hover:text-gold-600 leading-snug">{cycle.data.title}</h3>
                  <span class="shrink-0 rounded-full bg-ink-950 px-2.5 py-1 text-[10px] font-bold tracking-wider text-gold-400">{count} {t.count}</span>
                </div>
                <p class="text-sm text-ink-700/70 line-clamp-2 leading-relaxed">{cycle.data.description}</p>
                <div class="mt-3 flex items-center gap-1 text-xs font-semibold text-gold-600 group-hover:text-gold-500">
                  Zobacz cykl <span class="transition-transform group-hover:translate-x-0.5">→</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      {/* SEKCJA 2: ARTYKUŁY BEZ CYKLU */}
      <section class="mb-14">
        <h2 class="text-2xl font-bold mb-6 border-b-2 border-gold-500 pb-2">{t.standaloneTitle} ({standalone.length})</h2>
        {standalone.length === 0 ? (
          <p class="text-center text-ink-700/60 py-8">{t.empty}</p>
        ) : (
          <div class="flex flex-col gap-4">
            {standalone.map(post => (
              <a href={`/blog/${post.id}/`} class="group flex items-start gap-5 rounded-xl border border-parchment-200 bg-parchment-100 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 p-5">
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-ink-900 group-hover:text-gold-600 transition-colors leading-snug mb-1.5">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-ink-700/70 leading-relaxed line-clamp-2 mb-2.5">
                    {post.data.description}
                  </p>
                  <div class="flex items-center gap-2 text-xs text-ink-700/50">
                    <span>{post.data.pubDate.toLocaleDateString('pl-PL')}</span>
                    {post.data.author && <span>• {post.data.author}</span>}
                  </div>
                </div>
                <span class="hidden sm:flex items-center gap-1 text-xs font-semibold text-gold-600 group-hover:text-gold-500 ml-4 shrink-0">
                  {t.read} <span class="transition-transform group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </section>

      {/* SEKCJA 3: OSTATNIE LEKCJE Z CYKLI - TO NAPRAWIA "Strona odsyłająca: Nie wykryto" */}
      <section>
        <h2 class="text-2xl font-bold mb-2 border-b-2 border-gold-500 pb-2">{t.cyclesTitle}</h2>
        <p class="text-sm text-ink-700/60 mb-6">Ostatnie 24 lekcje z wszystkich cykli - bezpośrednie linki wewnętrzne dla Googlebota.</p>
        <div class="flex flex-col gap-3">
          {inCycles.map(post => {
            const cycleId = post.data.cycle ? (typeof post.data.cycle === 'string' ? post.data.cycle : post.data.cycle.id) : '';
            const lessonNum = (post.data as any).lessonNumber;
            return (
              <a href={`/blog/${post.id}/`} class="group flex items-start gap-4 rounded-xl border border-parchment-200 bg-white shadow-sm hover:shadow-md hover:border-gold-500/20 transition-all duration-300 hover:-translate-y-0.5 p-4">
                <div class="hidden sm:flex w-11 h-11 rounded-lg bg-ink-950 items-center justify-center shrink-0 shadow-inner">
                  <span class="font-display text-sm font-bold text-gold-400">
                    {typeof lessonNum === 'number' ? String(lessonNum).padStart(2,'0') : '•'}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-[15px] font-bold text-ink-900 group-hover:text-gold-600 transition-colors leading-snug line-clamp-2">
                    {post.data.title}
                  </h3>
                  <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-ink-700/50">
                    {cycleId && <span class="inline-flex items-center gap-1 rounded-full bg-parchment-100 px-2 py-0.5 border border-parchment-200">{cycleId}</span>}
                    <span>{post.data.pubDate.toLocaleDateString('pl-PL')}</span>
                  </div>
                </div>
                <span class="self-center text-gold-500/50 group-hover:text-gold-600 transition-colors">→</span>
              </a>
            );
          })}
        </div>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/cycles/" class="inline-flex items-center justify-center gap-2 rounded-full bg-ink-950 px-7 py-3 text-sm font-semibold text-parchment-50 hover:bg-ink-800 transition-colors shadow-lg shadow-ink-950/20">
            {t.allLessons} →
          </a>
          <a href="/sitemap-0.xml" class="inline-flex items-center justify-center gap-2 rounded-full border border-parchment-300 bg-white px-7 py-3 text-sm font-semibold text-ink-700 hover:bg-parchment-50 transition-colors">
            Mapa witryny (XML)
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
