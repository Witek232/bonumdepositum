---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Lista bloga pokazuje wyłącznie wpisy samodzielne (bez cyklu).
// Lekcje cykli są dostępne z menu „Cykle” oraz ze stron poszczególnych
// cykli (/cycles/<id>/), które linkują każdą swoją lekcję — dzięki temu
// usuwanie ich z tej listy nie tworzy stron sierocych (orphan pages):
// każda lekcja nadal ma link wewnętrzny ze strony swojego cyklu,
// a wszystkie adresy pozostają w mapie witryny.
const standalone = allPosts
  .filter(p => !p.data.cycle)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const t = {
  title: 'Blog – filozofia, duchowość i kultura',
  subtitle: 'Artykuły i eseje',
  description: 'Eseje i artykuły o filozofii, duchowołości, kulturze i społeczeństwie. Lekcje cykli tematycznych — katechizm Fultona Sheena, Podziemny podręcznik tyranii czy Serce areną zbawienia — znajdziesz w osobnej sekcji „Cykle”.',
  read: 'Czytaj',
  standaloneTitle: 'Artykuły',
  empty: 'Brak dostępnych artykułów.',
};
---

<Layout
  title={t.title}
  description={t.description}
  lang="pl"
  image="/og-image.jpg"
  heroPage={true}
>
  <PageHero minHeight="min-h-[50vh]">
    <p class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">
      {t.subtitle}
    </p>
    <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-parchment-50 lg:text-5xl">
      {t.title}
    </h1>
    <div class="mx-auto mt-6 h-px w-32 bg-gradient-to-r from-transparent via-gold-500/50 to-transparent" />
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-parchment-200/70">
      {t.description}
    </p>
  </PageHero>

  <div class="main-content min-h-screen shadow-2xl rounded-t-2xl -mt-4 pt-16 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
    <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">

      {/* Drogowskaz: lekcje cykli żyją we własnej sekcji (menu „Cykle”) */}
      <a
        href="/cycles/"
        class="group mb-10 flex items-center justify-between gap-4 rounded-xl border border-parchment-200 bg-parchment-100 px-5 py-4 transition-all duration-300 hover:border-gold-500/40 hover:shadow-md"
      >
        <p class="text-sm leading-relaxed text-ink-700/80">
          Szukasz lekcji z cykli tematycznych — katechizmu Fultona Sheena,
          „Podziemnego podręcznika tyranii” czy „Serca areną zbawienia”?
          One mają własną sekcję.
        </p>
        <span class="shrink-0 inline-flex items-center gap-1 text-xs font-semibold text-gold-600 group-hover:text-gold-500">
          Cykle
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </span>
      </a>

      {/* ARTYKUŁY — tylko wpisy samodzielne */}
      <section>
        <h2 class="text-2xl font-bold mb-6 border-b-2 border-gold-500 pb-2">
          {t.standaloneTitle} ({standalone.length})
        </h2>
        {standalone.length === 0 ? (
          <p class="text-center text-ink-700/60 py-8">{t.empty}</p>
        ) : (
          <div class="flex flex-col gap-4">
            {standalone.map(post => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex items-start gap-5 rounded-xl border border-parchment-200 bg-parchment-100 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 p-5"
              >
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-ink-900 group-hover:text-gold-600 transition-colors leading-snug mb-1.5">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-ink-700/70 leading-relaxed line-clamp-2 mb-2.5">
                    {post.data.description}
                  </p>
                  <div class="flex items-center gap-2 text-xs text-ink-700/50">
                    <span>{post.data.pubDate.toLocaleDateString('pl-PL')}</span>
                    {post.data.author && <span>• {post.data.author}</span>}
                  </div>
                </div>
                <span class="hidden sm:flex items-center gap-1 text-xs font-semibold text-gold-600 group-hover:text-gold-500 ml-4 shrink-0">
                  {t.read}
                  <span class="transition-transform group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </section>

    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
