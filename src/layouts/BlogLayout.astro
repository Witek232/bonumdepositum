---
import BlogSidebar from '@/components/BlogSidebar.astro';
---

<div class="blog-layout">
  <BlogSidebar />
  
  <main class="blog-content">
    <slot />
  </main>
</div>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem;
  }

  @media (max-width: 1024px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
