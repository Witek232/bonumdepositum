---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'pl' | 'en' | 'es';
  /**
   * heroPage: true  → strona główna z Hero
   *   - <main> bez pt-20, bez max-w kontenera, bez bg
   *   - Hero sam zarządza całą sekcją (min-h:100vh od top:0)
   *
   * heroPage: false (domyślnie) → podstrona
   *   - <main> z pt-20 (kompensacja fixed nav h-20=80px)
   *   - <main> z klasą main-content (jasne tło parchment)
   *   - wewnętrzny <div> max-w-[50rem] ogranicza szerokość tekstu
   */
  heroPage?: boolean;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  lang = 'pl',
  heroPage = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Bonum Depositum';
const locale = lang === 'pl' ? 'pl_PL' : lang === 'en' ? 'en_US' : 'es_ES';
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title} | {siteName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={locale} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.site)} />

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Zapobiegaj FOUC + x-cloak -->
  <style>[x-cloak] { display: none !important; }</style>
  <script is:inline>
    (function () {
      const dark = localStorage.getItem('darkMode') === 'true';
      if (dark) document.documentElement.classList.add('dark');
    })();
  </script>
</head>

<body
  data-pagefind-body
  x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', mobileMenuOpen: false }"
  x-bind:class="{ 'dark': darkMode }"
  x-init="$watch('darkMode', val => {
    localStorage.setItem('darkMode', String(val));
    document.documentElement.classList.toggle('dark', val);
  })"
>
  <Navigation currentPath={Astro.url.pathname} lang={lang} />

  {heroPage
    ? (
      /*
       * TRYB HERO (strona główna):
       * - Brak pt-20 → Hero zaczyna od top:0 (nav jest fixed, nie zajmuje miejsca)
       * - Brak max-w kontenera → Hero ma pełną szerokość viewport
       * - Brak background → Hero sam ustawia ciemne tło przez własny gradient/obraz
       * - overflow-x:hidden zamiast clip → zapobiega poziomemu scrollowi
       */
      <main class="min-h-screen overflow-x-hidden">
        <slot />
      </main>
    )
    : (
      /*
       * TRYB PODSTRONY:
       * - pt-20 = 80px = wysokość fixed nav (h-20) → treść nie jest przykryta
       * - main-content → klasa z global.css nadaje jasne tło parchment-50
       * - pb-12 → oddech na dole
       * - max-w-[50rem] wewnątrz → optymalna szerokość kolumny dla czytelności
       */
      <main class="main-content min-h-screen pt-20 pb-12 overflow-x-hidden">
        <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
          <slot />
        </div>
      </main>
    )
  }

  <Footer lang={lang} />
  <ScrollToTop />
</body>
</html>
