---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'pl' | 'en' | 'es';
  /**
   * heroPage: true  → strona główna z Hero
   *   - <main> bez pt-20, bez max-w kontenera, bez bg
   *   - Hero sam zarządza całą sekcją (min-h:100vh od top:0)
   *
   * heroPage: false (domyślnie) → podstrona
   *   - <main> z pt-20 (kompensacja fixed nav h-20=80px)
   *   - <main> z klasą main-content (jasne tło parchment)
   *   - wewnętrzny <div> max-w-[50rem] ogranicza szerokość tekstu
   */
  heroPage?: boolean;
  /** Typ Open Graph: website (domyślnie) lub article */
  type?: 'website' | 'article';
  /** Data publikacji (wymagana dla type="article") — ISO lub Date */
  datePublished?: string | Date;
  /** Data modyfikacji (opcjonalna dla type="article") — ISO lub Date */
  dateModified?: string | Date;
  /** Autor (dla type="article") */
  author?: string;
  /** Dodatkowe obiekty JSON-LD (schema.org) wstrzykiwane do @graph */
  schema?: Record<string, unknown>[];
  /** noindex — np. strona 404 */
  noindex?: boolean;
  /** Pomiń <link rel="canonical"> (np. strona 404 — nie powinna mieć canonical) */
  omitCanonical?: boolean;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  lang = 'pl',
  heroPage = false,
  type = 'website',
  datePublished,
  dateModified,
  author,
  schema = [],
  noindex = false,
  omitCanonical = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://bonumdepositum.eu/');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
const siteName = 'Bonum Depositum';
const locale = lang === 'pl' ? 'pl_PL' : lang === 'en' ? 'en_US' : 'es_ES';

const pubDateISO = datePublished instanceof Date
  ? datePublished.toISOString()
  : datePublished ?? undefined;
const modDateISO = dateModified instanceof Date
  ? dateModified.toISOString()
  : dateModified ?? pubDateISO;

// === Dane strukturalne JSON-LD (schema.org) ===
const schemaGraph = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl.toString(),
    name: siteName,
    inLanguage: 'pl-PL',
    description:
      'Portal o filozofii, duchowości i klasycznej edukacji katolickiej: artykuły, lekcje katechizmu, cykle tematyczne i czytelnia klasycznych tekstów.',
    publisher: { '@id': `${siteUrl}#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${siteUrl}#organization`,
    name: siteName,
    url: siteUrl.toString(),
    logo: `${siteUrl}favicon.svg`,
  },
  ...schema,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#f6f1e6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#171310" media="(prefers-color-scheme: dark)" />
  <Font cssVariable="--font-noto-serif" />
  {!omitCanonical && <link rel="canonical" href={canonicalURL} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{title} | {siteName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Bonum Depositum — filozofia, edukacja, duchowość" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={locale} />

  {type === 'article' && pubDateISO && (
    <>
      <meta property="article:published_time" content={pubDateISO} />
      {modDateISO && <meta property="article:modified_time" content={modDateISO} />}
      {author && <meta property="article:author" content={author} />}
    </>
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Dane strukturalne JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Zapobiegaj FOUC + x-cloak -->
  <style>[x-cloak] { display: none !important; }</style>
  <script is:inline>
    (function () {
      const dark = localStorage.getItem('darkMode') === 'true';
      if (dark) document.documentElement.classList.add('dark');
    })();
  </script>
</head>

<body
  data-pagefind-body
  x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', mobileMenuOpen: false }"
  x-bind:class="{ 'dark': darkMode }"
  x-init="$watch('darkMode', val => {
    localStorage.setItem('darkMode', String(val));
    document.documentElement.classList.toggle('dark', val);
  })"
>
  <Navigation currentPath={Astro.url.pathname} lang={lang} />

  {heroPage
    ? (
      <main class="min-h-screen overflow-x-hidden">
        <slot />
      </main>
    )
    : (
      <main class="main-content min-h-screen pt-20 pb-12 overflow-x-hidden">
        <div class="mx-auto max-w-[50rem] px-4 sm:px-6 lg:px-8">
          <slot />
        </div>
      </main>
    )
  }

  <Footer lang={lang} />
  <ScrollToTop />
</body>
</html>
