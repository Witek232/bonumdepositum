---
import { Font } from 'astro:assets';
import { SEO } from 'astro-seo';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
 
const { title, description, image, lang = 'pl' } = Astro.props;
 
// Konfiguracja SEO
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const locale = lang === 'pl' ? 'pl_PL' : lang === 'en' ? 'en_US' : 'es_ES';
---
 
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Czcionka Noto Serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  
  <!-- SEO -->
  <SEO
    title={title}
    description={description}
    canonical={canonicalURL}
    openGraph={image ? {
      title: title,
      description: description,
      url: canonicalURL,
      site_name: 'Bonum Depositum',
      images: [{ url: image }],
      locale: locale,
      type: 'website',
    } : undefined}
    twitter={{
      card: image ? 'summary_large_image' : 'summary',
      title: title,
      description: description,
      images: image ? [image] : [],
    }}
  />
  
  <!-- Style globalne -->
  <style is:global>
    @import '../styles/global.css';
  </style>
  
  <!-- Alpine.js do trybu ciemnego -->
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>
<body x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
  
  <!-- Nawigacja -->
  <Navigation currentPath={Astro.url.pathname} lang={lang} />
  
  <!-- Główna treść -->
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <slot />
  </main>
  
  <!-- Stopka -->
  <Footer lang={lang} />
  
  <!-- Przełącznik trybu ciemnego -->
  <ThemeToggle />
  
  <!-- Skrypt dla trybu ciemnego -->
  <script>
    // Obsługa przełącznika
    document.addEventListener('alpine:init', () => {
      Alpine.data('themeToggle', () => ({
        darkMode: localStorage.getItem('darkMode') === 'true',
        
        toggleTheme() {
          this.darkMode = !this.darkMode;
          localStorage.setItem('darkMode', this.darkMode);
          
          // Aktualizacja klasy na html
          document.documentElement.classList.toggle('dark', this.darkMode);
        },
        
        init() {
          // Inicjalizacja - synchronizacja z localStorage
          document.documentElement.classList.toggle('dark', this.darkMode);
        }
      }));
    });
  </script>
</body>
</html>
 
