---
// src/components/BlogSidebar.astro
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Przygotowanie danych do wyszukiwania
const searchablePosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .map(post => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description || '',
    tags: post.data.tags || [],
    cycle: post.data.cycle || '',
    url: `/blog/${post.id}/`,
  }));

// Grupowanie po cyklach
const cycles = new Map<string, any[]>();
const standalone: any[] = [];

allPosts.forEach(post => {
  if (post.data.cycle) {
    if (!cycles.has(post.data.cycle)) cycles.set(post.data.cycle, []);
    cycles.get(post.data.cycle)!.push(post);
  } else {
    standalone.push(post);
  }
});
---

<aside class="blog-sidebar">
  <!-- WYSZUKIWARKA -->
  <div class="search-wrapper">
    <input 
      type="text" 
      id="search-input" 
      placeholder="Szukaj artykułów..." 
      class="search-input"
    />
    <div id="search-results" class="search-results"></div>
  </div>

  <!-- MENU Z CYKLAMI -->
  <div class="menu-content">
    {Array.from(cycles.entries()).map(([cycleName, posts]) => (
      <details class="cycle-group" open>
        <summary>
          {cycleName} 
          <span class="count">({posts.length})</span>
        </summary>
        <ul>
          {posts.map(post => (
            <li>
              <a href={`/blog/${post.id}/`} class={Astro.url.pathname.includes(post.id) ? 'active' : ''}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}

    {standalone.length > 0 && (
      <div class="standalone-section">
        <h4>Inne artykuły</h4>
        <ul>
          {standalone.map(post => (
            <li>
              <a href={`/blog/${post.id}/`} class={Astro.url.pathname.includes(post.id) ? 'active' : ''}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</aside>

<script define:vars={{ posts: searchablePosts }}>
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const menuContent = document.querySelector('.menu-content');

  function searchPosts(query) {
    if (!query || query.length < 2) {
      resultsContainer.innerHTML = '';
      if (menuContent) menuContent.style.display = 'block';
      return;
    }

    const q = query.toLowerCase();

    const filtered = posts.filter(post => 
      post.title.toLowerCase().includes(q) ||
      post.description.toLowerCase().includes(q) ||
      post.tags.some(tag => tag.toLowerCase().includes(q)) ||
      post.cycle.toLowerCase().includes(q)
    );

    if (menuContent) menuContent.style.display = 'none';

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `<p class="no-results">Nie znaleziono artykułów</p>`;
      return;
    }

    resultsContainer.innerHTML = filtered.map(post => `
      <a href="${post.url}" class="search-result">
        <strong>${post.title}</strong>
        ${post.description ? `<p>${post.description}</p>` : ''}
        ${post.cycle ? `<span class="cycle-badge">${post.cycle}</span>` : ''}
      </a>
    `).join('');
  }

  input.addEventListener('input', (e) => {
    searchPosts(e.target.value);
  });

  // Zamykanie wyników po kliknięciu poza wyszukiwarką
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-wrapper')) {
      resultsContainer.innerHTML = '';
      if (menuContent) menuContent.style.display = 'block';
    }
  });
</script>

<style>
  .blog-sidebar {
    position: sticky;
    top: 2rem;
    width: 280px;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding-right: 1rem;
    font-size: 0.95rem;
    border-right: 1px solid #eee;
  }

  .search-wrapper {
    position: sticky;
    top: 0;
    background: white;
    padding-bottom: 1rem;
    z-index: 10;
    border-bottom: 1px solid #eee;
    margin-bottom: 1rem;
  }

  .search-input {
    width: 100%;
    padding: 0.65rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 0.95rem;
    outline: none;
  }

  .search-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    max-height: 400px;
    overflow-y: auto;
    z-index: 20;
    margin-top: 4px;
  }

  .search-result {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #f1f1f1;
  }

  .search-result:last-child {
    border-bottom: none;
  }

  .search-result:hover {
    background-color: #f8f9fa;
  }

  .search-result strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .search-result p {
    font-size: 0.8rem;
    color: #666;
    margin: 0;
    line-height: 1.35;
  }

  .cycle-badge {
    display: inline-block;
    font-size: 0.7rem;
    background: #e0e7ff;
    color: #1e40af;
    padding: 1px 8px;
    border-radius: 9999px;
    margin-top: 0.4rem;
  }

  .no-results {
    padding: 1rem;
    color: #888;
    font-style: italic;
  }

  .cycle-group summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.6rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cycle-group summary:hover {
    color: #2563eb;
  }

  .count {
    font-weight: 400;
    color: #888;
    font-size: 0.85rem;
  }

  .blog-sidebar ul {
    list-style: none;
    padding-left: 1rem;
    margin: 0.25rem 0 1rem;
  }

  .blog-sidebar a {
    display: block;
    padding: 0.4rem 0.6rem;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .blog-sidebar a:hover {
    background-color: #f8f9fa;
  }

  .blog-sidebar a.active {
    background-color: #e0e7ff;
    color: #1e40af;
    font-weight: 500;
  }

  .standalone-section h4 {
    font-size: 0.9rem;
    color: #555;
    margin: 1.5rem 0 0.5rem;
  }

  /* Mobile */
  @media (max-width: 1024px) {
    .blog-sidebar {
      position: static;
      width: 100%;
      border-right: none;
      border-bottom: 1px solid #eee;
    }
  }

  .blog-page {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem;
  }

  .blog-content {
    max-width: 780px;
    line-height: 1.7;
  }

  @media (max-width: 1024px) {
    .blog-page {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
