---
// Komponent używa Alpine.js
---

<div x-data="{ showTopBtn: false }" 
     @scroll.window="showTopBtn = window.scrollY > 400" 
     x-show="showTopBtn"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0 translate-y-4"
     x-transition:enter-end="opacity-100 translate-y-0"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100 translate-y-0"
     x-transition:leave-end="opacity-0 translate-y-4"
     class="fixed bottom-6 right-6 z-50">
     
  <button 
    @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
    class="p-3 rounded-full bg-amber-700 hover:bg-amber-600 text-white shadow-xl border border-amber-500 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-400"
    aria-label="Przewiń na górę"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>

</div>
