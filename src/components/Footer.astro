---
const { lang = 'pl' } = Astro.props;
const currentYear = new Date().getFullYear();

// Tłumaczenia dla stopki
const translations = {
  pl: {
    tagline: 'Przestrzeń, gdzie historia spotyka się z nowoczesnością.',
    home: 'Strona główna',
    blog: 'Blog',
    cycles: 'Cykle',
    reading: 'Czytelnia',
    rights: 'Wszelkie prawa zastrzeżone.',
    builtWith: 'Zbudowano z',
  },
  en: {
    tagline: 'A space where history meets modernity.',
    home: 'Home',
    blog: 'Blog',
    cycles: 'Series',
    reading: 'Reading Room',
    rights: 'All rights reserved.',
    builtWith: 'Built with',
  },
  es: {
    tagline: 'Un espacio donde la historia se encuentra con la modernidad.',
    home: 'Inicio',
    blog: 'Blog',
    cycles: 'Ciclos',
    reading: 'Sala de lectura',
    rights: 'Todos los derechos reservados.',
    builtWith: 'Construido con',
  }
};

const t = translations[lang] || translations.pl;

// Logika dla prawidłowych linków zależnie od języka
const prefix = lang === 'pl' ? '' : `/${lang}`;

const footerLinks = [
  { href: `${prefix}/`, text: t.home },
  { href: `${prefix}/blog`, text: t.blog },
  { href: `${prefix}/cycles`, text: t.cycles },
  { href: `${prefix}/reading`, text: t.reading },
];
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 mt-16">
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    
    <!-- Główna siatka stopki -->
    <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-8">
      
      <!-- Lewa kolumna: Marka i opis -->
      <div class="text-center md:text-left max-w-sm">
        <a href={`${prefix}/`} class="text-2xl font-bold text-ink dark:text-dark-ink hover:text-accent dark:hover:text-dark-accent transition-colors font-serif">
          Bonum Depositum
        </a>
        <p class="mt-3 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
          {t.tagline}
        </p>
      </div>

      <!-- Prawa kolumna: Szybka nawigacja -->
      <div class="text-center md:text-right">
        <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wider mb-4">
          Nawigacja
        </h3>
        <nav class="flex flex-col gap-2" aria-label="Footer navigation">
          {footerLinks.map(link => (
            <a 
              href={link.href} 
              class="text-ink dark:text-dark-ink hover:text-accent dark:hover:text-dark-accent transition-colors text-sm"
            >
              {link.text}
            </a>
          ))}
        </nav>
      </div>
      
    </div>

    <!-- Dekoracyjny separator -->
    <hr class="my-8 border-gray-200 dark:border-gray-800" />

    <!-- Dolna sekcja: Prawa autorskie i technologie -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-500 dark:text-gray-400">
      <p>© {currentYear} Bonum Depositum. {t.rights}</p>
      <p>
        {t.builtWith} 
        <a href="https://astro.build" target="_blank" rel="noopener" class="text-accent dark:text-dark-accent hover:underline">Astro</a> 
        & 
        <a href="https://tailwindcss.com" target="_blank" rel="noopener" class="text-accent dark:text-dark-accent hover:underline">Tailwind CSS</a>
      </p>
    </div>
    
  </div>
</footer>
