---
const { lang = 'pl' } = Astro.props;
const currentYear = new Date().getFullYear();

const translations = {
  pl: {
    tagline: 'Przestrzeń, gdzie historia spotyka się z nowoczesnością.',
    home: 'Strona główna',
    blog: 'Blog',
    cycles: 'Cykle',
    reading: 'Czytelnia',
    rights: 'Wszelkie prawa zastrzeżone.',
    builtWith: 'Zbudowano z',
    navigation: 'Nawigacja',
  },
  en: {
    tagline: 'A space where history meets modernity.',
    home: 'Home',
    blog: 'Blog',
    cycles: 'Series',
    reading: 'Reading Room',
    rights: 'All rights reserved.',
    builtWith: 'Built with',
    navigation: 'Navigation',
  },
  es: {
    tagline: 'Un espacio donde la historia se encuentra con la modernidad.',
    home: 'Inicio',
    blog: 'Blog',
    cycles: 'Ciclos',
    reading: 'Sala de lectura',
    rights: 'Todos los derechos reservados.',
    builtWith: 'Construido con',
    navigation: 'Navegación',
  },
};

const t = translations[lang] || translations.pl;

const prefix = lang === 'pl' ? '' : `/${lang}`;
// Link „Strona główna” usunięty z listy — rolę odnośnika do strony głównej
// pełni nazwa serwisu w lewej kolumnie („Bonum Depositum”).
// PRZYWRÓCENIE: dopisz ponownie wiersz  { href: `${prefix}/`, text: t.home },  na początek listy.
const footerLinks = [
  { href: `${prefix}/blog`, text: t.blog },
  { href: `${prefix}/cycles`, text: t.cycles },
  { href: `${prefix}/reading`, text: t.reading },
];
---

<footer class="relative bg-ink-950 pt-20 pb-12">
  <!-- Dekoracyjny separator gradientowy na górze -->
  <div
    class="absolute top-0 right-0 left-0 h-px bg-gradient-to-r from-transparent via-gold-500/30 to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Subtelne tło w kropki (ciągłość z Fundamentami) -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, #d4a843 0.5px, transparent 0); background-size: 60px 60px;"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Główna siatka -->
    <div
      class="flex flex-col md:flex-row justify-between items-center md:items-start gap-10"
    >
      <!-- Lewa kolumna: Marka -->
      <div class="text-center md:text-left max-w-sm">
        <a
          href={`${prefix}/`}
          class="inline-block text-2xl font-bold text-parchment-50 hover:text-gold-400 transition-colors duration-300 font-display"
        >
          Bonum Depositum
        </a>
        <p class="mt-3 text-sm leading-relaxed text-parchment-200/50">
          {t.tagline}
        </p>
      </div>

      <!-- Prawa kolumna: Nawigacja -->
      <div class="text-center md:text-right">
        <h3
          class="text-xs font-semibold text-gold-400/70 uppercase tracking-[0.2em] mb-4"
        >
          {t.navigation}
        </h3>
        <nav class="flex flex-col gap-2" aria-label="Footer navigation">
          {
            footerLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-parchment-200/60 hover:text-gold-400 transition-colors duration-200"
              >
                {link.text}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <!-- Separator -->
    <div
      class="my-10 h-px bg-gradient-to-r from-transparent via-gold-500/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <!-- Dolna sekcja -->
    <div
      class="flex flex-col sm:flex-row justify-center items-center gap-4 text-xs text-parchment-200/40"
    >
      <p>
        &copy; {currentYear} Bonum Depositum. {t.rights}
      </p>
    </div>
  </div>
</footer>
