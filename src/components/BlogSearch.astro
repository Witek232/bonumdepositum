---
// src/components/BlogSearch.astro
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Przygotowujemy dane do wyszukiwania
const searchablePosts = allPosts.map(post => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description || '',
  tags: post.data.tags || [],
  cycle: post.data.cycle || '',
  url: `/blog/${post.id}/`,
}));
---

<div class="blog-search">
  <input 
    type="text" 
    id="search-input" 
    placeholder="Szukaj artykułów..." 
    class="search-input"
  />
  
  <div id="search-results" class="search-results"></div>
</div>

<script define:vars={{ posts: searchablePosts }}>
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  function searchPosts(query) {
    if (!query || query.length < 2) {
      resultsContainer.innerHTML = '';
      return;
    }

    const q = query.toLowerCase();

    const filtered = posts.filter(post => 
      post.title.toLowerCase().includes(q) ||
      post.description.toLowerCase().includes(q) ||
      post.tags.some(tag => tag.toLowerCase().includes(q)) ||
      post.cycle.toLowerCase().includes(q)
    );

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `<p class="no-results">Nie znaleziono artykułów</p>`;
      return;
    }

    resultsContainer.innerHTML = filtered.map(post => `
      <a href="${post.url}" class="search-result">
        <strong>${post.title}</strong>
        ${post.description ? `<p>${post.description}</p>` : ''}
        ${post.cycle ? `<span class="cycle-badge">${post.cycle}</span>` : ''}
      </a>
    `).join('');
  }

  input.addEventListener('input', (e) => {
    searchPosts(e.target.value);
  });
</script>

<style>
  .search-input {
    width: 100%;
    padding: 0.6rem 1rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .search-results {
    max-height: 400px;
    overflow-y: auto;
  }

  .search-result {
    display: block;
    padding: 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    margin-bottom: 0.25rem;
  }

  .search-result:hover {
    background-color: #f8f9fa;
  }

  .search-result strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .search-result p {
    font-size: 0.85rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  .cycle-badge {
    display: inline-block;
    font-size: 0.75rem;
    background: #e0e7ff;
    color: #1e40af;
    padding: 1px 8px;
    border-radius: 9999px;
    margin-top: 0.4rem;
  }

  .no-results {
    color: #888;
    font-style: italic;
    padding: 0.5rem;
  }
</style>
