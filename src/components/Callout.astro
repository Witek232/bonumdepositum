---
// Callout — informacyjne okienko w estetyce pergamin/złoto
interface Props {
  type?: 'lang' | 'info' | 'quote';
  title?: string;
  icon?: 'globe' | 'info' | 'quote';
}

const { type = 'info', title, icon = 'info' } = Astro.props;

const styles: Record<string, string> = {
  lang: 'border-gold-500/30 bg-gold-500/5 text-ink-800',
  info: 'border-sage-600/30 bg-sage-600/5 text-ink-800',
  quote: 'border-parchment-400/60 bg-parchment-100/60 text-ink-800 italic',
};

const iconSvg: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  info: '<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="16" y2="12"/><line x1="12" x2="12.01" y1="8" y2="8"/>',
  quote: '<path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>',
};
---

<div class={`callout my-8 rounded-xl border px-5 py-4 ${styles[type]}`}>
  <div class="flex items-start gap-3">
    {icon && (
      <div class="mt-0.5 flex-shrink-0">
        <svg class="h-4 w-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvg[icon]} />
      </div>
    )}
    <div class="min-w-0">
      {title && <p class="mb-1 text-sm font-semibold tracking-wide">{title}</p>}
      <div class="text-sm leading-relaxed opacity-90">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .callout p:last-child {
    margin-bottom: 0;
  }
</style>
