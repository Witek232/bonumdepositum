---
// IIIFViewer – czytnik książek/dokumentów oparty o IIIF + Tify
// Obsługuje manifesty IIIF Presentation API 2.x i 3.0 (m.in. Polona.pl)
//
// Użycie w MDX:
//   import IIIFViewer from '@/components/IIIFViewer.astro'
//   <IIIFViewer manifestUrl="https://polona.pl/api/.../manifest.json" title="Nazwa dokumentu" />

interface Props {
  manifestUrl: string;
  title?: string;
}

const { manifestUrl, title = 'Dokument cyfrowy' } = Astro.props;
const viewerId = `tify-${Math.random().toString(36).slice(2, 9)}`;
const sourceLabel = manifestUrl.includes('polona.pl') ? 'Polona.pl' : 'IIIF Manifest';
---

<!-- CSS Tify – ⚠️ KLUCZOWE: osobny <link> poza komponentem, żeby Astro na pewno hoistnęło do <head> -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/tify@0.35.0/dist/tify.css"
/>

<div
  class="iiif-viewer not-prose my-8 border border-parchment-400/40 rounded-lg overflow-hidden bg-ink-950 shadow-lg"
>
  <!-- Kontener przeglądarki + placeholder ładowania -->
  <div
    id={viewerId}
    data-manifest-url={manifestUrl}
    class="tify-container relative"
    style="min-height: 75vh"
  >
    <!-- Placeholder widoczny przed inicjalizacją Tify -->
    <div class="tify-placeholder absolute inset-0 flex flex-col items-center justify-center gap-3 text-parchment-200/60 z-0">
      <svg class="animate-spin h-8 w-8 text-gold-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Ładowanie dokumentu…</span>
    </div>
  </div>

  <!-- Pasek informacyjny -->
  <div
    class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 bg-parchment-100/10 border-t border-parchment-400/30 text-sm"
  >
    <span class="text-parchment-200/60">
      Źródło:&#32;
      <a
        href={manifestUrl}
        target="_blank"
        rel="noopener"
        class="text-gold-400 hover:text-gold-300 underline underline-offset-2 transition-colors"
      >
        {sourceLabel}
      </a>
    </span>

    <button
      type="button"
      id={`fs-${viewerId}`}
      class="px-3 py-1 text-xs border border-gold-500/40 text-gold-300 hover:bg-gold-500/10 rounded transition-colors cursor-pointer select-none"
    >
      ⛶ Pełny ekran
    </button>
  </div>
</div>

<script is:inline>
  (function boot() {
    // Helper: init Tify
    function initOne(c) {
      if (c.querySelector('.tify')) return; // już zainicjalizowany

      var url = c.getAttribute('data-manifest-url');
      var id  = c.id;

      import('https://cdn.jsdelivr.net/npm/tify@0.35.0/dist/tify.esm.js')
        .then(function (mod) {
          var Tify = mod.default || mod;
          new Tify({
            container: '#' + id,
            manifestUrl: url,
            language: 'pl',
          });
        })
        .catch(function (err) {
          console.error('IIIFViewer: nie udało się załadować Tify', err);
          c.innerHTML =
            '<div style="display:flex;align-items:center;justify-content:center;height:200px;color:#d4a843;font-family:serif;text-align:center;padding:2rem">' +
            '<div>⚠️ Nie udało się załadować czytnika.<br>' +
            '<a href="' + url + '" target="_blank" style="color:#c49a38;text-decoration:underline">Otwórz manifest źródłowy</a></div>' +
            '</div>';
        });
    }

    // Fullscreen button handler
    function bindFS() {
      document.querySelectorAll('.iiif-viewer button[id^="fs-"]').forEach(function (btn) {
        if (btn._boundFS) return;
        btn._boundFS = true;
        btn.addEventListener('click', function () {
          var viewer = btn.closest('.iiif-viewer');
          if (!viewer) return;
          var container = viewer.querySelector('.tify-container');
          if (!container) return;
          if (document.fullscreenElement) {
            document.exitFullscreen();
          } else {
            container.requestFullscreen();
          }
        });
      });
    }

    // Init on ready
    function initAll() {
      document.querySelectorAll('.tify-container[data-manifest-url]').forEach(initOne);
      bindFS();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>
