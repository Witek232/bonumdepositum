---
// O nas — jasna sekcja między Hero a Fundament
---

<section
  id="about"
  class="about-section relative overflow-hidden bg-parchment-50 py-28 lg:py-36"
>
  <!-- Subtelna tekstura tła -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, #2c2418 1px, transparent 0); background-size: 40px 40px;"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
      <!-- Obraz -->
      <div class="about-image relative">
        <div
          class="relative overflow-hidden rounded-2xl shadow-2xl shadow-ink-900/20"
        >
          <img
            src="/images/about.jpg"
            alt="Kontemplacja i poszukiwanie mądrości"
            class="about-img aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-ink-950/50 via-transparent to-transparent"
          >
          </div>
        </div>
        <!-- Dekoracyjna ramka -->
        <div
          class="absolute -top-4 -left-4 h-24 w-24 border-t-2 border-l-2 border-gold-500/30 rounded-tl-2xl pointer-events-none"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -right-4 -bottom-4 h-24 w-24 border-r-2 border-b-2 border-gold-500/30 rounded-br-2xl pointer-events-none"
          aria-hidden="true"
        >
        </div>
      </div>

      <!-- Tekst -->
      <div class="about-text">
        <p
          class="mb-4 text-xs font-semibold tracking-[0.3em] text-gold-600 uppercase"
        >
          O naszej misji
        </p>
        <h2
          class="font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 lg:text-5xl"
        >
          Szukamy prawdy
          <br />
          <span class="text-gold-600">od tysięcy lat</span>
        </h2>
        <div
          class="my-8 h-px w-20 bg-gradient-to-r from-gold-500 to-transparent"
        >
        </div>
        <p class="text-lg leading-relaxed text-ink-700/80">
          <strong class="text-ink-900">Bonum Depositum</strong> to przestrzeń,
          w której spotykają się najgłębsze tradycje ludzkiej myśli. Łączymy
          filozofię klasyczną z tradycjami duchowymi i współczesną edukacją,
          tworząc unikalną ścieżkę poznania.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-ink-700/80">
          Wierzymy, że prawdziwa mądrość rodzi się na styku rozumu i ducha —
          tam, gdzie pytania stają się ważniejsze od odpowiedzi, a pokora
          wobec tajemnicy otwiera drzwi do głębszego rozumienia.
        </p>

        <!-- Statystyki -->
        <div class="mt-10 flex items-center gap-8">
          <div>
            <div class="font-display text-3xl font-bold text-gold-600">
              2600+
            </div>
            <div class="mt-1 text-sm text-ink-700/60">Lat tradycji</div>
          </div>
          <div class="h-12 w-px bg-parchment-300"></div>
          <div>
            <div class="font-display text-3xl font-bold text-gold-600">
              150+
            </div>
            <div class="mt-1 text-sm text-ink-700/60">Dzieł klasycznych</div>
          </div>
          <div class="h-12 w-px bg-parchment-300"></div>
          <div>
            <div class="font-display text-3xl font-bold text-gold-600">∞</div>
            <div class="mt-1 text-sm text-ink-700/60">Pytań do zadania</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Reset globalnych stylów img dla tej sekcji */
  .about-section img {
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    display: block;
  }

  /* Animacje wejścia */
  .about-image,
  .about-text {
    opacity: 0;
    transition: opacity 1s ease-out, transform 1s ease-out;
  }
  .about-image {
    transform: translateX(-3rem); /* -translate-x-12 */
  }
  .about-text {
    transform: translateX(3rem); /* translate-x-12 */
    transition-delay: 200ms;
  }

  #about.is-visible .about-image,
  #about.is-visible .about-text {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script is:inline>
  (function () {
    const section = document.getElementById("about");
    if (!section) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(section);
  })();
</script>
