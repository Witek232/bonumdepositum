---
import { getCollection } from 'astro:content';

export interface Props {
  currentPath?: string;
  lang?: 'pl' | 'en' | 'es';
}

const { currentPath = Astro.url.pathname, lang = 'pl' } = Astro.props;

const cycles = await getCollection('cycles');
const sortedCycles = cycles
  .filter(c => c.data.lang === 'pl')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const navItems = [
  { label: 'Strona główna', href: '/' },
  { label: 'Blog', href: '/blog/' },
  {
    label: 'Cykle',
    href: '/cycles/',
    children: [
      ...sortedCycles.map(c => ({
        label: c.data.title,
        href: `/cycles/${c.id}/`,
      })),
    ],
  },
  { label: 'Czytelnia', href: '/reading/' },
];

const langItems = [
  { label: 'PL', href: '/', code: 'pl' },
  { label: 'EN', href: '/en/', code: 'en' },
  { label: 'ES', href: '/es/', code: 'es' },
];
---

<nav
  id="main-nav"
  class="fixed top-0 right-0 left-0 z-50 h-20 border-b border-parchment-200/10 bg-ink-950/80 backdrop-blur-md transition-all duration-300"
>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6 lg:px-8">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group no-underline">
      <div class="relative h-10 w-10 rounded-lg bg-gradient-to-br from-gold-500 to-gold-700 flex items-center justify-center shadow-lg shadow-gold-500/20 group-hover:shadow-gold-500/30 transition-shadow">
        <span class="font-display text-lg font-bold text-ink-950">B</span>
      </div>
      <span class="font-display text-xl lg:text-2xl font-bold text-parchment-50 hidden sm:block">
        Bonum Depositum
      </span>
    </a>

    <!-- Desktop menu -->
    <div class="hidden lg:flex items-center gap-1">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href.replace(/\/$/, '')));
        const hasChildren = !!item.children;

        return (
          <div class={`relative nav-item ${hasChildren ? 'has-dropdown' : ''}`} data-label={item.label}>
            <a
              href={item.href}
              class={`relative px-4 py-2 rounded-lg text-base font-medium transition-all duration-200 flex items-center gap-1.5 no-underline
                ${isActive 
                  ? 'text-gold-400 bg-gold-500/10' 
                  : 'text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5'
                }`}
            >
              {item.label}
              {hasChildren && (
                <svg class="h-3.5 w-3.5 transition-transform duration-200 dropdown-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              )}
            </a>

            {hasChildren && (
              <div class="dropdown-panel absolute top-full left-0 w-64 rounded-xl border border-parchment-200/10 bg-ink-950/95 backdrop-blur-md shadow-2xl shadow-black/40 py-2 overflow-hidden opacity-0 invisible translate-y-1 transition-all duration-200 pointer-events-none">
                {item.children.map(child => (
                  <a href={child.href} class="block px-4 py-2.5 text-base transition-colors no-underline text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5">
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>

   <!-- WYSZUKIWARKA (Pagefind) -->
<div class="hidden lg:block nav-search">
  <div id="search"></div>
</div>

    <!-- Language switcher + Mobile hamburger -->
    <div class="flex items-center gap-3">
      
      <!-- Language switcher (desktop) -->
      <div class="hidden lg:flex items-center gap-1 rounded-lg border border-parchment-200/10 bg-ink-950/60 px-1 py-1">
        {langItems.map(l => (
          <a
            href={l.href}
            class={`px-2 py-1 rounded text-sm font-semibold transition-colors no-underline ${
              l.code === lang
                ? 'bg-gold-500/20 text-gold-400'
                : 'text-parchment-200/50 hover:text-parchment-200 hover:bg-parchment-200/5'
            }`}
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-lg text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5 transition-colors"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
        <svg id="menu-icon-close" class="h-6 w-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </div>

  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-parchment-200/10 bg-ink-950/95 backdrop-blur-md"
  >
    <div class="px-6 py-4 space-y-1">
      {navItems.map((item, idx) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href.replace(/\/$/, '')));
        const hasChildren = !!item.children;

        return (
          <div>
            <div class="flex items-center justify-between">
              <a
                href={item.href}
                class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors no-underline flex-1 ${
                  isActive
                    ? 'text-gold-400 bg-gold-500/10'
                    : 'text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5'
                }`}
              >
                {item.label}
              </a>
              {hasChildren && (
                <button
                  class="mobile-submenu-toggle p-2 text-parchment-200/70 hover:text-parchment-100 transition-colors"
                  data-target={`mobile-submenu-${idx}`}
                  aria-expanded="false"
                >
                  <svg class="h-4 w-4 transition-transform duration-200 chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
              )}
            </div>
            {hasChildren && (
              <div id={`mobile-submenu-${idx}`} class="hidden ml-4 mt-1 space-y-1 border-l-2 border-gold-500/20 pl-4">
                {item.children.map(child => (
                  <a href={child.href} class="block px-3 py-2 rounded-lg text-base text-parchment-200/60 hover:text-parchment-100 hover:bg-parchment-200/5 transition-colors no-underline">
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}

      <!-- Mobile language switcher -->
      <div class="mt-4 pt-4 border-t border-parchment-200/10 flex items-center gap-2">
        <span class="text-sm font-semibold uppercase tracking-wider text-parchment-200/40">Język</span>
        <div class="flex items-center gap-1">
          {langItems.map(l => (
            <a
              href={l.href}
              class={`px-3 py-1.5 rounded-lg text-base font-medium transition-colors no-underline ${
                l.code === lang
                  ? 'bg-gold-500/20 text-gold-400'
                  : 'text-parchment-200/50 hover:text-parchment-200 hover:bg-parchment-200/5'
              }`}
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .no-underline { text-decoration: none !important; }

  .nav-item.has-dropdown:hover .dropdown-panel,
  .nav-item.has-dropdown:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-item.has-dropdown:hover .dropdown-chevron,
  .nav-item.has-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  .search-input {
    padding: 7px 36px 7px 14px;
    border: 1px solid #4b5563;
    border-radius: 9999px;
    font-size: 0.9rem;
    width: 240px;
    background: #1f2937;
    color: #e5e7eb;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #f59e0b;
    background: #111827;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
  }

  .search-input::placeholder {
    color: #9ca3af;
  }

  .search-submit {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    padding: 4px;
  }

  .search-submit:hover {
    color: #f59e0b;
  }

#search {
  width: 260px;
}

.pagefind-ui {
  --pagefind-ui-font: inherit;
  --pagefind-ui-border-radius: 8px;
  --pagefind-ui-background: #1f2937;
  --pagefind-ui-text: #e5e7eb;
  --pagefind-ui-border: #4b5563;
}

</style>

<script is:inline>
  (function() {
    // Mobile menu
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (toggle && menu) {
      toggle.addEventListener('click', function() {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
        if (iconOpen) iconOpen.classList.toggle('hidden', !isOpen);
        if (iconClose) iconClose.classList.toggle('hidden', isOpen);
      });
    }

    // Mobile submenus
    document.querySelectorAll('.mobile-submenu-toggle').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const target = document.getElementById(targetId);
        const icon = this.querySelector('.chevron-icon');
        if (!target) return;

        const isOpen = !target.classList.contains('hidden');
        target.classList.toggle('hidden');
        this.setAttribute('aria-expanded', String(!isOpen));
        if (icon) icon.style.transform = isOpen ? '' : 'rotate(180deg)';
      });
    });

    // Navbar scroll effect
    const nav = document.getElementById('main-nav');
    if (nav) {
      window.addEventListener('scroll', function() {
        const currentScroll = window.scrollY;
        if (currentScroll > 50) {
          nav.classList.add('bg-ink-950/95', 'shadow-lg', 'shadow-black/20');
          nav.classList.remove('bg-ink-950/80');
        } else {
          nav.classList.remove('bg-ink-950/95', 'shadow-lg', 'shadow-black/20');
          nav.classList.add('bg-ink-950/80');
        }
      });
    }

    <!-- WYSZUKIWARKA (Pagefind) -->
<div class="hidden lg:block nav-search">
  <div id="search"></div>
</div>

<style>
  #search {
    width: 260px;
  }
  
  .pagefind-ui {
    --pagefind-ui-font: inherit;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-background: #1f2937;
    --pagefind-ui-text: #e5e7eb;
    --pagefind-ui-border: #4b5563;
  }
</style>

<script>
  import { PagefindUI } from '@pagefind/default-ui';
  import '@pagefind/default-ui/css/ui.css';

  new PagefindUI({
    element: "#search",
    showImages: false,
    showEmptyFilters: false,
    resetStyles: false,
    translations: {
      placeholder: "Szukaj artykułów i cykli...",
      clear_search: "Wyczyść",
      load_more: "Załaduj więcej",
      zero_results: "Brak wyników dla [SEARCH_TERM]",
    }
  });
</script>
