---
import { getCollection } from 'astro:content';

const cycles = await getCollection('cycles');
const sortedCycles = cycles
  .filter(c => c.data.lang === 'pl')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const navItems = [
  { label: 'Strona główna', href: '/' },
  {
    label: 'Blog',
    href: '/blog/',
    children: [
      { label: 'Wszystkie artykuły', href: '/blog/' },
      { label: 'Cykle', href: '/cycles/' },
      ...sortedCycles.map(c => ({
        label: c.data.title,
        href: `/cycles/${c.id}/`,
      })),
    ],
  },
  { label: 'Czytelnia', href: '/reading/' },
];

const currentPath = Astro.url.pathname;
---

<nav
  id="main-nav"
  class="fixed top-0 right-0 left-0 z-50 h-20 border-b border-parchment-200/10 bg-ink-950/80 backdrop-blur-md transition-all duration-300"
  x-data="{ mobileOpen: false, activeDropdown: null }"
>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative h-10 w-10 rounded-lg bg-gradient-to-br from-gold-500 to-gold-700 flex items-center justify-center shadow-lg shadow-gold-500/20 group-hover:shadow-gold-500/30 transition-shadow">
        <span class="font-display text-lg font-bold text-ink-950">B</span>
      </div>
      <span class="font-display text-xl font-bold text-parchment-50 hidden sm:block">
        Bonum Depositum
      </span>
    </a>

    <!-- Desktop menu -->
    <div class="hidden lg:flex items-center gap-1">
      {navItems.map(item => (
        <div 
          class="relative"
          @mouseenter="activeDropdown = '{item.label}'"
          @mouseleave="activeDropdown = null"
        >
          <a
            href={item.href}
            class={`relative px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex items-center gap-1.5
              ${currentPath === item.href || currentPath.startsWith(item.href.replace(/\/$/, '')) 
                ? 'text-gold-400 bg-gold-500/10' 
                : 'text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5'
              }`}
          >
            {item.label}
            {item.children && (
              <svg 
                class={`h-3.5 w-3.5 transition-transform duration-200 ${item.children ? 'mt-0.5' : ''}`}
                :class="activeDropdown === '{item.label}' ? 'rotate-180' : ''"
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2.5" 
                stroke-linecap="round" 
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            )}
          </a>

          {item.children && (
            <div
              x-show="activeDropdown === '{item.label}'"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 translate-y-1"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 translate-y-1"
              x-cloak
              class="absolute top-full left-0 mt-2 w-64 rounded-xl border border-parchment-200/10 bg-ink-950/95 backdrop-blur-md shadow-2xl shadow-black/40 py-2 overflow-hidden"
            >
              <div class="px-3 py-2 border-b border-parchment-200/10 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wider text-gold-500/70">{item.label}</span>
              </div>
              {item.children.map((child, idx) => (
                <a
                  href={child.href}
                  class={`block px-4 py-2.5 text-sm transition-colors ${
                    idx === 0 
                      ? 'text-gold-400 font-medium hover:bg-gold-500/10' 
                      : 'text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5'
                  }`}
                >
                  {idx === 1 && <div class="h-px bg-parchment-200/10 my-1 -mx-4" />}
                  {idx > 1 && idx === 2 && <div class="h-px bg-parchment-200/10 my-1 -mx-4" />}
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Mobile hamburger -->
    <button
      @click="mobileOpen = !mobileOpen"
      class="lg:hidden p-2 rounded-lg text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5 transition-colors"
      aria-label="Menu"
    >
      <svg x-show="!mobileOpen" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
      <svg x-show="mobileOpen" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    x-cloak
    class="lg:hidden border-t border-parchment-200/10 bg-ink-950/95 backdrop-blur-md"
  >
    <div class="px-6 py-4 space-y-1">
      {navItems.map(item => (
        <div>
          <a
            href={item.href}
            @click="mobileOpen = false"
            class={`block px-4 py-3 rounded-lg text-sm font-medium transition-colors ${
              currentPath === item.href || currentPath.startsWith(item.href.replace(/\/$/, ''))
                ? 'text-gold-400 bg-gold-500/10'
                : 'text-parchment-200/70 hover:text-parchment-100 hover:bg-parchment-200/5'
            }`}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ml-4 mt-1 space-y-1 border-l-2 border-gold-500/20 pl-4">
              {item.children.map(child => (
                <a
                  href={child.href}
                  @click="mobileOpen = false"
                  class="block px-3 py-2 rounded-lg text-sm text-parchment-200/60 hover:text-parchment-100 hover:bg-parchment-200/5 transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</nav>

<style>
  [x-cloak] { display: none !important; }
</style>

<script is:inline>
  // Navbar scroll effect
  (function() {
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    
    let lastScroll = 0;
    window.addEventListener('scroll', function() {
      const currentScroll = window.scrollY;
      
      if (currentScroll > 50) {
        nav.classList.add('bg-ink-950/95', 'shadow-lg', 'shadow-black/20');
        nav.classList.remove('bg-ink-950/80');
      } else {
        nav.classList.remove('bg-ink-950/95', 'shadow-lg', 'shadow-black/20');
        nav.classList.add('bg-ink-950/80');
      }
      
      lastScroll = currentScroll;
    });
  })();
</script>
