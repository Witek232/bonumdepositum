---
const { currentPath, lang = 'pl' } = Astro.props;

const translations = {
  pl: {
    home: 'Strona główna',
    blog: 'Blog',
    cycles: 'Cykle',
    reading: 'Czytelnia',
  },
  en: {
    home: 'Home',
    blog: 'Blog',
    cycles: 'Series',
    reading: 'Reading Room',
  },
  es: {
    home: 'Inicio',
    blog: 'Blog',
    cycles: 'Ciclos',
    reading: 'Sala de Lectura',
  }
};

const t = translations[lang] || translations.pl;

const pages = [
  { href: `/${lang === 'pl' ? '' : lang + '/'}`, text: t.home },
  { href: `/${lang === 'pl' ? 'blog' : lang + '/blog'}`, text: t.blog },
  { href: `/${lang === 'pl' ? 'cycles' : lang + '/cycles'}`, text: t.cycles },
  { href: `/${lang === 'pl' ? 'reading' : lang + '/reading'}`, text: t.reading },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">

      <!-- Logo -->
      <a href="/" class="group flex items-center gap-3">
        <div class="nav-logo-icon flex h-10 w-10 items-center justify-center rounded-lg border transition-colors duration-300">
          <svg class="h-5 w-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <span class="font-serif text-xl font-bold tracking-wide text-parchment-100">
          Bonum Depositum
        </span>
      </a>

      <!-- Menu desktopowe -->
      <div class="hidden md:flex items-center gap-1">
        {pages.map(page => (
          <a
            href={page.href}
            class={`nav-link rounded-lg px-4 py-2 text-sm font-medium tracking-wide transition-all duration-300
              ${currentPath === page.href ? 'nav-link-active' : ''}`}
          >
            {page.text}
          </a>
        ))}

        <!-- PRZEŁĄCZNIK TRYBU (Desktop) -->
        <button 
          @click="darkMode = !darkMode" 
          class="ml-2 rounded-lg p-2 text-parchment-200 transition-colors duration-200 hover:bg-gold-500/10 hover:text-gold-400" 
          aria-label="Zmień tryb jasny/ciemny"
        >
          <!-- Słońce (widoczne w trybie ciemnym) -->
          <svg x-show="darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Księżyc (widoczny w trybie jasnym) -->
          <svg x-show="!darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Przełącznik językowy -->
        <div class="hidden sm:flex items-center gap-1 text-sm font-medium border-l border-gold-500/10 pl-4 ml-2">
          <a href="/pl" class={`nav-lang px-2 py-1 rounded transition-colors duration-200 ${lang === 'pl' ? 'nav-lang-active' : ''}`}>PL</a>
          <span class="nav-sep">·</span>
          <a href="/en" class={`nav-lang px-2 py-1 rounded transition-colors duration-200 ${lang === 'en' ? 'nav-lang-active' : ''}`}>EN</a>
          <span class="nav-sep">·</span>
          <a href="/es" class={`nav-lang px-2 py-1 rounded transition-colors duration-200 ${lang === 'es' ? 'nav-lang-active' : ''}`}>ES</a>
        </div>
      </div>

      <!-- Prawa strona mobile: tryb + hamburger -->
      <div class="flex items-center gap-2 md:hidden">

        <!-- PRZEŁĄCZNIK TRYBU (Mobile) -->
        <button 
          @click="darkMode = !darkMode" 
          class="rounded-lg p-2 text-parchment-200 transition-colors duration-200 hover:bg-gold-500/10 hover:text-gold-400" 
          aria-label="Zmień tryb jasny/ciemny"
        >
          <svg x-show="darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg x-show="!darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Hamburger (mobile) -->
        <button
          id="mobileMenuBtn"
          class="rounded-lg p-2 text-parchment-200 transition-colors duration-200 hover:bg-gold-500/10"
          aria-label="Otwórz menu"
          aria-expanded="false"
        >
          <svg id="iconMenu" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="iconClose" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobilne -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-gold-500/10 bg-ink-950/98 backdrop-blur-xl">
    <div class="space-y-1 px-6 py-4">
      {pages.map(page => (
        <a
          href={page.href}
          class={`nav-mobile-link block rounded-lg px-4 py-3 text-sm font-medium tracking-wide transition-colors duration-200
            ${currentPath === page.href ? 'nav-mobile-link-active' : ''}`}
        >
          {page.text}
        </a>
      ))}
      <!-- Języki w mobile -->
      <div class="flex items-center gap-2 px-4 pt-3 pb-1 text-sm border-t border-gold-500/10 mt-2">
        <a href="/pl" class={`nav-lang px-2 py-1 rounded ${lang === 'pl' ? 'nav-lang-active' : ''}`}>PL</a>
        <span class="nav-sep">·</span>
        <a href="/en" class={`nav-lang px-2 py-1 rounded ${lang === 'en' ? 'nav-lang-active' : ''}`}>EN</a>
        <span class="nav-sep">·</span>
        <a href="/es" class={`nav-lang px-2 py-1 rounded ${lang === 'es' ? 'nav-lang-active' : ''}`}>ES</a>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer -->
<div class="h-20"></div>

<style>
  /* Zawsze ciemne tło — na górze przezroczyste, po scrollu pełne */
  #main-nav {
    background-color: transparent;
  }
  #main-nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--color-ink-950) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Logo ikona */
  .nav-logo-icon {
    border-color: color-mix(in srgb, var(--color-gold-500) 30%, transparent);
    background-color: color-mix(in srgb, var(--color-gold-500) 10%, transparent);
  }
  .nav-logo-icon svg {
    color: var(--color-gold-400);
  }
  a:hover .nav-logo-icon {
    background-color: color-mix(in srgb, var(--color-gold-500) 20%, transparent);
  }

  /* Linki desktop */
  .nav-link {
    color: color-mix(in srgb, var(--color-parchment-200) 80%, transparent);
  }
  .nav-link:hover {
    background-color: color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    color: var(--color-gold-400);
    text-decoration: none;
  }
  .nav-link-active {
    color: var(--color-gold-400);
    font-weight: 700;
  }

  /* Języki */
  .nav-lang {
    color: color-mix(in srgb, var(--color-parchment-200) 60%, transparent);
    font-weight: 500;
  }
  .nav-lang:hover {
    color: var(--color-gold-400);
    text-decoration: none;
  }
  .nav-lang-active {
    color: var(--color-gold-400);
    font-weight: 700;
  }
  .nav-sep {
    color: color-mix(in srgb, var(--color-gold-500) 35%, transparent);
  }

  /* Menu mobilne */
  .nav-mobile-link {
    color: color-mix(in srgb, var(--color-parchment-200) 80%, transparent);
  }
  .nav-mobile-link:hover {
    background-color: color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    color: var(--color-gold-400);
    text-decoration: none;
  }
  .nav-mobile-link-active {
    color: var(--color-gold-400);
    font-weight: 700;
  }

  /* Animacja rozwijania */
  #mobileMenu.is-open {
    animation: slideDown 0.3s ease-out forwards;
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  const iconMenu = document.getElementById('iconMenu');
  const iconClose = document.getElementById('iconClose');

  // Scroll
  function updateScroll() {
    nav?.classList.toggle('nav-scrolled', window.scrollY > 60);
  }
  window.addEventListener('scroll', updateScroll, { passive: true });
  updateScroll();

  // Hamburger
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      menu?.classList.remove('is-open');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    } else {
      menu?.classList.remove('hidden');
      menu?.classList.add('is-open');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    }
  });

  // Zamknij po kliknięciu linka
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menu?.classList.remove('is-open');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
