---
interface Props {
  url: string;
  title?: string;
  source?: 'polona' | 'archive';
}

const { 
  url, 
  title = "Zasób cyfrowy", 
  source = 'archive' 
} = Astro.props;
---

<figure class="w-full max-w-4xl mx-auto my-8">
  <div 
    class:list={[
      "rounded-lg overflow-hidden shadow-lg border border-gray-200 dark:border-gray-700",
      source === 'polona' ? 'aspect-[3/4]' : 'aspect-[4/3]'
    ]}
  >
    <iframe
      src={url}
      title={title}
      width="100%"
      height="100%"
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups"
      referrerpolicy="no-referrer"
      class="border-0 w-full h-full block"
    ></iframe>
  </div>
  
  <figcaption class="mt-2 text-sm text-gray-600 dark:text-gray-400 text-center">
    Źródło: 
    <a 
      href={url} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="text-blue-600 dark:text-blue-400 hover:underline"
    >
      {source === 'polona' ? 'Polona.pl' : 'Archive.org'}
    </a>
  </figcaption>
</figure>
