---
// Ten komponent opiera się o Alpine.js zdefiniowane w Layout.astro
---

<div x-data="themeToggle" class="fixed bottom-6 right-6 z-50">
  <button 
    @click="toggleTheme()" 
    class="p-3 rounded-full bg-white dark:bg-gray-800 shadow-lg border border-gray-200 dark:border-gray-700 text-ink dark:text-dark-ink hover:scale-110 transition-transform duration-200 focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-dark-accent"
    :aria-label="darkMode ? 'Przełącz na tryb jasny' : 'Przełącz na tryb ciemny'"
  >
    <!-- Ikona słońca (widoczna w trybie ciemnym, by przejść do jasnego) -->
    <svg 
      x-show="darkMode" 
      class="w-6 h-6" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor"
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="2"
    >
      <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>

    <!-- Ikona księżyca (widoczna w trybie jasnym, by przejść do ciemnego) -->
    <svg 
      x-show="!darkMode" 
      class="w-6 h-6" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor"
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="2"
    >
      <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
</div>
