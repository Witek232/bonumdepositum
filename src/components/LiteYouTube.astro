---
// Web Component — brak named exportu, rejestruje się sam przez side-effect import
import 'lite-youtube-embed/src/lite-yt-embed.css';

const { videoid, title } = Astro.props;
---

<!-- Opakowanie zachowane identycznie jak oryginał -->
<div class="w-full my-8 rounded-lg overflow-hidden shadow-lg border border-gray-200 dark:border-gray-700">
  <lite-youtube videoid={videoid} data-title={title}></lite-youtube>
</div>

<!-- JS jako side-effect: rejestruje <lite-youtube> w customElements -->
<script>
  import 'lite-youtube-embed/src/lite-yt-embed.js';
</script>

<style>
  /*
    Mały trik CSS: biblioteka lite-youtube-embed tworzy własny kontener.
    Upewniamy się, że zajmuje 100% szerokości naszego opakowania.
  */
  :global(lite-youtube) {
    width: 100%;
    margin: 0; /* Usuwamy domyślny margines z biblioteki, bo obsługujemy go przez Tailwind (my-8) */
  }
</style>
