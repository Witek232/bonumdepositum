---
interface Props {
  lang?: 'pl' | 'en' | 'es';
}
const { lang = 'pl' } = Astro.props;

const translations = {
  pl: {
    tagline: 'Filozofia · Edukacja · Duchowość',
    heading1: 'Poznaj mądrość',
    heading2: 'która trwa wiecznie',
    description: 'Odkryj fundamenty ludzkiej myśli — od starożytnych filozofów, przez wielkich teologów, po współczesnych myślicieli. Wiedza, która kształtuje umysł i ducha.',
    cta1: 'Odkryj filary mądrości',
    cta2: 'Nauki mistrzów',
    scroll: 'Przewiń',
    cta1href: '#pillars',
    cta2href: '/blog/',
    scrollhref: '#about',
  },
  en: {
    tagline: 'Philosophy · Education · Spirituality',
    heading1: 'Discover wisdom',
    heading2: 'that endures forever',
    description: 'Explore the foundations of human thought — from ancient philosophers to great theologians and modern thinkers. Knowledge that shapes mind and spirit.',
    cta1: 'Explore the pillars of wisdom',
    cta2: 'Teachings of the masters',
    scroll: 'Scroll',
    cta1href: '#pillars',
    cta2href: '/blog/',
    scrollhref: '#about',
  },
  es: {
    tagline: 'Filosofía · Educación · Espiritualidad',
    heading1: 'Descubre la sabiduría',
    heading2: 'que perdura para siempre',
    description: 'Explora los fundamentos del pensamiento humano — desde filósofos antiguos, grandes teólogos hasta pensadores modernos. El conocimiento que forma la mente y el espíritu.',
    cta1: 'Descubre los pilares de la sabiduría',
    cta2: 'Enseñanzas de los maestros',
    scroll: 'Desplázate',
    cta1href: '#pillars',
    cta2href: '/blog/',
    scrollhref: '#about',
  },
};

const t = translations[lang] || translations.pl;
---

<!--
  Wymagania dla rodzica (Layout.astro):
    heroPage={true} → <main> bez pt-20 i bez max-w kontenera
  
  Hero sam odpowiada za:
    1. Rozciągnięcie na pełen viewport (min-h-screen, width:100%)
    2. Własne ciemne tło (gradient + obraz)
    3. Przesunięcie treści poniżej fixed nav przez padding-top na .hero-content
-->
<section
  id="home"
  class="hero-section relative flex min-h-screen items-center justify-center overflow-hidden"
>
  <!-- =============================================
       TŁO: obraz + gradienty
       img.hero-bg ma własne style zerujące globalne
       margin/border-radius z global.css
       ============================================= -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-bg.jpg"
      alt=""
      aria-hidden="true"
      class="hero-bg h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Gradient pionowy: bardziej ciemny u góry (za nav), rozjaśnia się, ciemno u dołu -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0804]/85 via-[#0a0804]/55 to-[#0a0804]/90"></div>
    <!-- Gradient poziomy: przyciemnia boki -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a0804]/40 via-transparent to-[#0a0804]/40"></div>
  </div>

  <!-- =============================================
       ORNAMENT GÓRNY
       Pozycjonowany relative do top ekranu:
       nav h-20 = 80px + 1.5rem buforu wizualnego
       ============================================= -->
  <div
    class="absolute left-1/2 -translate-x-1/2 z-10 opacity-20 pointer-events-none"
    style="top: calc(80px + 1.5rem);"
    aria-hidden="true"
  >
    <svg width="200" height="40" viewBox="0 0 200 40" fill="none">
      <path d="M0 20 H80 M120 20 H200" stroke="#d4a843" stroke-width="1" />
      <circle cx="100" cy="20" r="8" stroke="#d4a843" stroke-width="1" fill="none" />
      <circle cx="100" cy="20" r="3" fill="#d4a843" />
      <path d="M85 20 L92 13 M85 20 L92 27 M115 20 L108 13 M115 20 L108 27" stroke="#d4a843" stroke-width="1" />
    </svg>
  </div>

  <!-- =============================================
       TREŚĆ GŁÓWNA
       z-index: 10 (nad tłem)
       padding-top: kompensuje fixed nav (80px + bufor)
       ============================================= -->
  <div class="hero-content relative z-10 mx-auto max-w-5xl px-6 text-center w-full">

    <p class="hero-tagline animate-fade-in-up delay-200 opacity-0 mb-6 text-sm font-semibold uppercase">
      {t.tagline}
    </p>

    <h1 class="animate-fade-in-up delay-300 opacity-0 hero-heading font-serif font-bold leading-tight tracking-tight">
      {t.heading1}
      <br />
      <span class="hero-heading-gradient">
        {t.heading2}
      </span>
    </h1>

    <p class="animate-fade-in-up delay-500 opacity-0 hero-description mx-auto mt-8 max-w-2xl leading-relaxed">
      {t.description}
    </p>

    <div class="animate-fade-in-up delay-600 opacity-0 mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
      <a href={t.cta1href} class="hero-btn-primary">
        <span class="relative z-10">{t.cta1}</span>
      </a>
      <a href={t.cta2href} class="hero-btn-secondary">
        {t.cta2}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Wskaźnik scrollowania -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10">
    <a href={t.scrollhref} class="hero-scroll-indicator flex flex-col items-center gap-2">
      <span class="text-xs tracking-[0.2em] uppercase">{t.scroll}</span>
      <div class="h-12 w-px bg-gradient-to-b from-[#d4a843]/50 to-transparent"></div>
    </a>
  </div>

  <!-- Dolna linia dekoracyjna -->
  <div
    class="absolute right-0 bottom-0 left-0 z-10 h-px bg-gradient-to-r from-transparent via-[#c49a38]/30 to-transparent"
    aria-hidden="true"
  ></div>
</section>

<style>
  /* =============================================
     HERO SECTION
     - width: 100% — pełna szerokość <main> (bez kontenera max-w)
     - NIE używamy breakout hack margin:-50vw
       bo: (1) <main> nie ma max-w, więc jest zbędny
           (2) overflow-x:hidden na rodzicu i tak by go blokował
     ============================================= */
  .hero-section {
    width: 100%;
  }

  /* =============================================
     HERO CONTENT — kluczowy padding-top
     h-20 nav = 80px. Dodajemy 2rem buforu.
     Dzięki temu tekst nie jest przykryty przez fixed nav.
     To odpowiednik clamp(5.5rem,14vw,8.5rem) z wersji "ar".
     ============================================= */
  .hero-content {
    padding-top: calc(80px + 2rem);
    padding-bottom: 2rem;
  }

  /* =============================================
     OBRAZ TŁA — reset globalnych stylów img
     Globalne img { margin:1.5rem; border-radius:0.5rem; }
     niszczyłyby układ tła. Klasa .hero-bg zeruje to.
     (Dodatkowe zabezpieczenie obok aria-hidden="true")
     ============================================= */
  .hero-bg {
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* =============================================
     TYPOGRAFIA HERO
     ============================================= */
  .hero-heading {
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: var(--color-parchment-50);
  }
  @media (min-width: 640px)  { .hero-heading { font-size: clamp(3rem, 9vw, 6rem); } }
  @media (min-width: 1024px) { .hero-heading { font-size: clamp(3.5rem, 10vw, 7rem); } }
  @media (min-width: 1280px) { .hero-heading { font-size: 4rem; } }

  .hero-heading-gradient {
    background: linear-gradient(
      to right,
      var(--color-gold-400),
      var(--color-gold-500),
      var(--color-gold-400)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .hero-tagline {
    letter-spacing: 0.35em;
    color: var(--color-gold-400);
  }

  .hero-description {
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-parchment-200) 70%, transparent);
  }
  @media (min-width: 640px) {
    .hero-description { font-size: 1.25rem; }
  }

  /* =============================================
     PRZYCISKI CTA
     ============================================= */
  .hero-btn-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-gold-500) 30%, transparent);
    background-color: color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-400);
    backdrop-filter: blur(4px);
    transition: all 0.5s ease;
    text-decoration: none;
  }
  .hero-btn-primary:hover {
    border-color: var(--color-gold-400);
    background-color: color-mix(in srgb, var(--color-gold-500) 20%, transparent);
    color: var(--color-gold-300, #e8c060);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    text-decoration: none;
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-parchment-300, #ddd0b8) 60%, transparent);
    transition: color 0.3s ease;
    text-decoration: none;
  }
  .hero-btn-secondary:hover {
    color: var(--color-parchment-100);
    text-decoration: none;
  }

  /* =============================================
     WSKAŹNIK SCROLLA
     ============================================= */
  .hero-scroll-indicator {
    color: color-mix(in srgb, var(--color-parchment-300, #ddd0b8) 40%, transparent);
    transition: color 0.3s ease;
    text-decoration: none;
  }
  .hero-scroll-indicator:hover {
    color: var(--color-gold-400);
    text-decoration: none;
  }
</style>
