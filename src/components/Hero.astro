<style>
  /* =========================================
     ROZWIĄZANIE: Wyjście poza ewentualne marginesy i rozciągnięcie na pełen ekran
     ========================================= */
  .hero-section {
    width: 100vw; /* Rozciągnij na całą szerokość okna przeglądarki */
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  /* Rozmiary nagłówka */
  .hero-heading {
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: var(--color-parchment-50);
  }
  @media (min-width: 640px)  { .hero-heading { font-size: clamp(3rem, 9vw, 6rem); } }
  @media (min-width: 1024px) { .hero-heading { font-size: clamp(3.5rem, 10vw, 7rem); } }
  @media (min-width: 1280px) { .hero-heading { font-size: 4rem; } }

  /* Gradient tekstu w nagłówku */
  .hero-heading-gradient {
    background: linear-gradient(
      to right,
      var(--color-gold-400),
      var(--color-gold-500),
      var(--color-gold-400)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Tagline */
  .hero-tagline {
    letter-spacing: 0.35em;
    color: var(--color-gold-400);
  }

  /* Opis */
  .hero-description {
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-parchment-200) 70%, transparent);
  }
  @media (min-width: 640px) {
    .hero-description { font-size: 1.25rem; }
  }

  /* Przycisk główny */
  .hero-btn-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-gold-500) 30%, transparent);
    background-color: color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-400);
    backdrop-filter: blur(4px);
    transition: all 0.5s ease;
    text-decoration: none;
  }
  .hero-btn-primary:hover {
    border-color: var(--color-gold-400);
    background-color: color-mix(in srgb, var(--color-gold-500) 20%, transparent);
    color: var(--color-gold-300, #e8c060);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-gold-500) 10%, transparent);
    text-decoration: none;
  }

  /* Przycisk drugorzędny */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-parchment-300, #ddd0b8) 60%, transparent);
    transition: color 0.3s ease;
    text-decoration: none;
  }
  .hero-btn-secondary:hover {
    color: var(--color-parchment-100);
    text-decoration: none;
  }

  /* Wskaźnik scrolla */
  .hero-scroll-indicator {
    color: color-mix(in srgb, var(--color-parchment-300, #ddd0b8) 40%, transparent);
    transition: color 0.3s ease;
    text-decoration: none;
  }
  .hero-scroll-indicator:hover {
    color: var(--color-gold-400);
    text-decoration: none;
  }
</style>
